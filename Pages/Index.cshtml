@page "/"
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VERSO Cafe — Point of Sale</title>
    <meta name="color-scheme" content="light dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=DM+Serif+Display&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/landing.css" />
    <script>
        // Apply saved theme (or OS preference) before first paint to avoid a flash
        (function () {
            try {
                var t = localStorage.getItem("verso-theme");
                if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                document.documentElement.setAttribute("data-theme", t);
            } catch (e) { document.documentElement.setAttribute("data-theme", "light"); }
        })();
    </script>
</head>
<body>
    <header class="nav">
        <a href="/" class="brand" aria-label="VERSO Cafe home">
            <span class="brand-mark">V</span>
            <span class="brand-name">VERSO Cafe</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
            <a href="#features">Features</a>
            <a href="#roles">Roles</a>
        </nav>
        <div class="nav-actions">
            <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode">
                <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
            <a href="/Login" class="btn btn-primary">Sign in</a>
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="hero-copy">
                <h1>Where every cup<br />tells a verse.</h1>
                <p class="lead">
                    The point-of-sale system built for VERSO Cafe. Take orders fast,
                    keep the menu and stock in order, and see how the day is going.
                </p>
                <div class="hero-cta">
                    <a href="/Login" class="btn btn-primary btn-lg">Sign in to your workspace</a>
                    <a href="#features" class="btn btn-ghost btn-lg">See what it does</a>
                </div>
            </div>

            <!-- Order ticket: the signature element -->
            <div class="ticket" role="img" aria-label="Example order ticket">
                <div class="ticket-head">
                    <span>Order #0142</span>
                    <span class="ticket-tag">Dine in</span>
                </div>
                <ul class="ticket-lines">
                    <li><span>2 × Iced Americano</span><span>₱ 220</span></li>
                    <li><span>1 × Spanish Latte</span><span>₱ 150</span></li>
                    <li><span>1 × Cheese Croissant</span><span>₱ 135</span></li>
                </ul>
                <div class="ticket-total"><span>Total</span><span>₱ 505</span></div>
                <div class="ticket-pay">Charge ₱ 505</div>
            </div>
        </section>

        <section id="features" class="section">
            <h2>Everything the counter needs</h2>
            <ul class="features">
                <li>
                    <h3>Fast ordering</h3>
                    <p>Ring up drinks and food in a few taps and send the order straight through.</p>
                </li>
                <li>
                    <h3>Menu and stock</h3>
                    <p>Keep items, prices and availability up to date in one place.</p>
                </li>
                <li>
                    <h3>Sales at a glance</h3>
                    <p>Check today's totals and recent orders without leaving the dashboard.</p>
                </li>
                <li>
                    <h3>Staff accounts</h3>
                    <p>Every team member signs in with their own username and password.</p>
                </li>
            </ul>
        </section>

        <section id="roles" class="section section-split">
            <div>
                <h2>The right access for each person</h2>
                <p class="muted">Admins, managers and cashiers each see only what their job needs.</p>
            </div>
            <ul class="roles">
                <li><span class="pill pill-admin">Admin</span> Manage staff, menu and settings.</li>
                <li><span class="pill pill-manager">Manager</span> Review sales and oversee the shift.</li>
                <li><span class="pill pill-cashier">Cashier</span> Take orders and process payments.</li>
            </ul>
        </section>

        <section class="cta">
            <h2>Ready to open the till?</h2>
            <a href="/Login" class="btn btn-primary btn-lg">Sign in</a>
        </section>
    </main>

    <footer class="footer">
        <span>© @PhTime.Now.Year VERSO Cafe</span>
        <span>Where every cup tells a verse.</span>
    </footer>

    <script>
        (function () {
            var root = document.documentElement;
            var btn = document.getElementById("theme-toggle");
            function sync() {
                var dark = root.getAttribute("data-theme") === "dark";
                btn.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
            }
            btn.addEventListener("click", function () {
                var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
                root.setAttribute("data-theme", next);
                try { localStorage.setItem("verso-theme", next); } catch (e) { }
                sync();
            });
            sync();
        })();
    </script>
</body>
</html>
