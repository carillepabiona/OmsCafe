@page
@model AccountManagementModel
@using OmsCafe.Models

@{
    ViewData["Title"] = "Account Management";
    ViewData["Subtitle"] = "Manage staff accounts and permissions";

    var viewRoute = Model.ShowArchived ? "archived" : null;

    // Pagination is only rendered when records exceed the page limit (i.e. more than 1 page)
    var showPagination = Model.TotalPages > 1;
    var pgStart = Math.Max(1, Model.CurrentPage - 2);
    var pgEnd   = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
}

@functions {
    static readonly string[] AvatarColors = { "av-brown", "av-green", "av-amber", "av-red", "av-purple" };

    static string Initials(string? fullName)
    {
        var parts = (fullName ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        if (parts.Length == 1) return (parts[0].Length >= 2 ? parts[0][..2] : parts[0]).ToUpper();
        return "?";
    }

    static string AvatarClass(Guid id) =>
        AvatarColors[(int)((uint)id.GetHashCode() % (uint)AvatarColors.Length)];

    static string RoleClass(string roleName) => roleName.ToLower() switch
    {
        "admin" => "role-admin",
        "manager" => "role-manager",
        _ => "role-cashier"
    };
}

@section TopbarActions {
    <div class="dropdown">
        <button class="btn-ghost-cafe dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="ti ti-download" aria-hidden="true"></i> Export
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" href="#" id="exportCsvBtn">
                    <i class="ti ti-file-text" style="margin-right:6px"></i> Export as CSV
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="#" id="exportJsonBtn">
                    <i class="ti ti-file-code" style="margin-right:6px"></i> Export as JSON
                </a>
            </li>
        </ul>
    </div>
    <button class="btn-primary-cafe" data-bs-toggle="modal" data-bs-target="#addAccountModal">
        <i class="ti ti-plus" aria-hidden="true"></i> Add Account
    </button>
}

<style>
    /* ── Password checklist (Add / Edit) ───────────────── */
    .pw-rules {
        list-style: none;
        margin: 8px 0 0;
        padding: 10px 12px;
        display: grid;
        gap: 5px;
        border: 1px solid rgba(128, 128, 128, .25);
        border-radius: 8px;
        font-size: 12.5px;
    }
    .pw-rules li { display: flex; align-items: center; gap: 8px; color: var(--text-mute, #7a6f64); }
    .pw-mark {
        flex: 0 0 16px; width: 16px; height: 16px; border-radius: 50%;
        border: 1.5px solid #b9b2a9;
        display: inline-grid; place-items: center;
        font-size: 10px; font-weight: 700; line-height: 1;
    }
    .pw-rules li.is-met { color: #1f8a4c; }
    .pw-rules li.is-met .pw-mark { background: #1f8a4c; border-color: #1f8a4c; color: #fff; }
    .pw-rules li.is-met .pw-mark::before { content: "\2713"; }
    .pw-rules li.is-unmet { color: #c0392b; }
    .pw-rules li.is-unmet .pw-mark { border-color: #e3b1ad; color: #c0392b; }
    .pw-rules li.is-unmet .pw-mark::before { content: "\2715"; }
    .pw-match { margin: 6px 0 0; min-height: 1em; font-size: 12.5px; }
    .pw-match.ok  { color: #1f8a4c; }
    .pw-match.bad { color: #c0392b; }

    /* ── Pending approval / reset panels ───────────────── */
    .pending-card {
        margin-bottom: 18px; padding: 16px 18px;
        border: 1px solid rgba(240, 180, 41, .5);
        background: rgba(240, 180, 41, .12);
        border-radius: 12px;
    }
    .pending-head { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 15px; }
    .pending-count {
        padding: 1px 9px; border-radius: 999px; font-size: 12px;
        background: #e0a100; color: #fff;
    }
    .pending-sub { margin: 4px 0 12px; font-size: 13px; color: var(--text-mute, #7a6f64); }
    .pending-list { display: grid; gap: 10px; }
    .pending-item {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px;
        padding: 10px 12px; border-radius: 10px;
        border: 1px solid rgba(128, 128, 128, .2);
        background: rgba(255, 255, 255, .5);
    }
    .pending-actions { display: flex; gap: 8px; }
    .pending-actions form { margin: 0; }

    /* ── Tabs: Accounts / Archived ─────────────────────── */
    .acct-tabs { display: flex; gap: 6px; padding: 0 0 12px; }
    .acct-tab {
        padding: 6px 12px; border-radius: 8px; font-size: 13px; font-weight: 500;
        color: var(--text-mute, #7a6f64); text-decoration: none;
    }
    .acct-tab:hover { background: rgba(128, 128, 128, .12); }
    .acct-tab.active { background: var(--brown, #FF8C00); color: #fff; }
    .acct-tab .tab-count {
        margin-left: 4px; padding: 0 6px; border-radius: 999px; font-size: 11px;
        background: rgba(128, 128, 128, .25);
    }
    .acct-tab.active .tab-count { background: rgba(255, 255, 255, .25); }

    .action-btns form { margin: 0; display: inline-flex; }

    /* ── Empty state row ───────────────────────────────── */
    .no-records-row td {
        text-align: center;
        padding: 36px 16px !important;
        color: var(--text-mute, #aaaaaa);
        font-size: 14px;
    }
    .no-records-row td i { font-size: 26px; display: block; margin-bottom: 8px; }
    .no-records-row:hover td { background: transparent !important; }

    /* ── Pagination fixes ──────────────────────────────── */
    .pagination-btns { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    .pg-btn { text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
    .pg-btn:not(.pg-btn-active):not(.disabled):hover {
        background: rgba(255, 140, 0, .10);
        border-color: rgba(255, 140, 0, .35);
        color: #e07b00;
    }
    .pg-btn.disabled { opacity: .4; pointer-events: none; cursor: default; }
    .pg-ellipsis { padding: 0 4px; color: var(--text-mute, #aaaaaa); user-select: none; }

    /* ── Contact fields ────────────────────────────────── */
    textarea.form-control-cafe { resize: vertical; min-height: 64px; font-family: inherit; }
    .view-wrap { white-space: pre-line; word-break: break-word; }

    /* ── Confirmation dialog ───────────────────────────── */
    #confirmModal .modal-dialog { max-width: 400px; }
    .confirm-body { text-align: center; padding: 28px 24px 8px; }
    .confirm-icon {
        width: 56px; height: 56px; margin: 0 auto 14px; border-radius: 50%;
        display: grid; place-items: center; font-size: 26px;
        background: rgba(255, 140, 0, .14); color: #e07b00;
    }
    .confirm-icon.tone-danger  { background: rgba(192, 57, 43, .12); color: #c0392b; }
    .confirm-icon.tone-success { background: rgba(31, 138, 76, .12); color: #1f8a4c; }
    .confirm-title { font-size: 17px; font-weight: 600; margin: 0 0 6px; }
    .confirm-message { margin: 0; font-size: 14px; line-height: 1.5; color: var(--text-sub, #666666); word-break: break-word; }
    .confirm-footer { justify-content: center; gap: 10px; border-top: 0; padding: 16px 24px 24px; }
    .confirm-footer button { min-width: 112px; justify-content: center; }
    #confirmOk.tone-danger  { background: #c0392b; border-color: #c0392b; color: #fff; }
    #confirmOk.tone-success { background: #1f8a4c; border-color: #1f8a4c; color: #fff; }
    #confirmOk.tone-danger:hover, #confirmOk.tone-success:hover { filter: brightness(.92); }
</style>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="font-size:13.5px;">
        <i class="ti ti-circle-check"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="font-size:13.5px;">
        <i class="ti ti-alert-circle"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ── Stat Cards ───────────────────────────────────────────── -->
<div class="stats-row">

    <div class="stat-card">
        <div class="stat-card-label">
            <i class="ti ti-users" aria-hidden="true"></i> Total Accounts
        </div>
        <div class="stat-card-value">@Model.TotalAccounts</div>
        <div class="stat-card-sub">
            <span class="text-success">↑ @Model.NewThisMonth this month</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-label">
            <i class="ti ti-circle-check" aria-hidden="true"></i> Active
        </div>
        <div class="stat-card-value">@Model.ActiveCount</div>
        <div class="stat-card-sub">
            @(Model.TotalAccounts > 0
                ? $"{(Model.ActiveCount * 100.0 / Model.TotalAccounts):F1}% of total"
                : "No accounts yet")
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-label">
            <i class="ti ti-shield" aria-hidden="true"></i> Admins
        </div>
        <div class="stat-card-value">@Model.AdminCount</div>
        <div class="stat-card-sub">Full access</div>
    </div>

    <div class="stat-card">
        <div class="stat-card-label">
            <i class="ti ti-circle-x" aria-hidden="true"></i> Inactive
        </div>
        <div class="stat-card-value">@Model.InactiveCount</div>
        <div class="stat-card-sub">
            <span class="text-danger">Requires attention</span>
        </div>
    </div>

</div>

<!-- ── Pending approval ──────────────────────────────────────── -->
@if (!Model.ShowArchived && Model.PendingUsers.Any())
{
    <div class="pending-card" id="pendingCard">
        <div class="pending-head">
            <i class="ti ti-user-check" aria-hidden="true"></i>
            Waiting for approval
            <span class="pending-count">@Model.PendingUsers.Count</span>
        </div>
        <p class="pending-sub">
            These people created their own account. Approve to let them sign in, or reject to decline the request.
        </p>

        <div class="pending-list">
            @foreach (var p in Model.PendingUsers)
            {
                var pendingRole = p.Role?.RoleName ?? "—";
                var requestedOn = p.CreatedAt.HasValue ? p.CreatedAt.Value.ToString("MMM dd, yyyy h:mm tt") : "—";

                <div class="pending-item">
                    <div class="avatar-cell">
                        <div class="av av-amber">@Initials(p.FullName)</div>
                        <div>
                            <div class="av-name">@p.FullName</div>
                            <div class="av-email">@p.Username · @pendingRole · requested @requestedOn</div>
                        </div>
                    </div>

                    <div class="pending-actions">
                        <form method="post" asp-page-handler="Approve"
                              data-confirm
                              data-confirm-title="Approve account"
                              data-confirm-message="Approve @(p.FullName)? They will be able to sign in right away."
                              data-confirm-ok="Approve"
                              data-confirm-tone="success"
                              data-confirm-icon="ti-user-check">
                            <input type="hidden" name="UserId" value="@p.UserId" />
                            <button type="submit" class="btn-primary-cafe">
                                <i class="ti ti-check" aria-hidden="true"></i> Approve
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Reject"
                              data-confirm
                              data-confirm-title="Reject request"
                              data-confirm-message="Reject @(p.FullName)'s request? It will be moved to the Archived tab."
                              data-confirm-ok="Reject"
                              data-confirm-tone="danger"
                              data-confirm-icon="ti-user-x">
                            <input type="hidden" name="UserId" value="@p.UserId" />
                            <button type="submit" class="btn-ghost-cafe">
                                <i class="ti ti-x" aria-hidden="true"></i> Reject
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- ── Password reset requests ───────────────────────────────── -->
@if (!Model.ShowArchived && Model.PendingResets.Any())
{
    <div class="pending-card" id="resetCard">
        <div class="pending-head">
            <i class="ti ti-key" aria-hidden="true"></i>
            Password reset requests
            <span class="pending-count">@Model.PendingResets.Count</span>
        </div>
        <p class="pending-sub">
            These staff members forgot their password and chose a new one. Confirm it is really them
            (in person or by phone) before approving. The new password only works after you approve it.
        </p>

        <div class="pending-list">
            @foreach (var r in Model.PendingResets)
            {
                var who = r.User!;
                var asked = r.RequestedAt.ToString("MMM dd, yyyy h:mm tt");

                <div class="pending-item">
                    <div class="avatar-cell">
                        <div class="av av-amber">@Initials(who.FullName)</div>
                        <div>
                            <div class="av-name">@who.FullName</div>
                            <div class="av-email">@who.Username · requested @asked</div>
                        </div>
                    </div>

                    <div class="pending-actions">
                        <form method="post" asp-page-handler="ApproveReset"
                              data-confirm
                              data-confirm-title="Approve password reset"
                              data-confirm-message="Activate the new password for @(who.FullName)? Only do this after you have confirmed the request really came from them."
                              data-confirm-ok="Approve"
                              data-confirm-tone="success"
                              data-confirm-icon="ti-key">
                            <input type="hidden" name="RequestId" value="@r.RequestId" />
                            <button type="submit" class="btn-primary-cafe">
                                <i class="ti ti-check" aria-hidden="true"></i> Approve
                            </button>
                        </form>
                        <form method="post" asp-page-handler="RejectReset"
                              data-confirm
                              data-confirm-title="Reject password reset"
                              data-confirm-message="Reject the password reset request from @(who.FullName)? Their current password stays the same."
                              data-confirm-ok="Reject"
                              data-confirm-tone="danger"
                              data-confirm-icon="ti-circle-x">
                            <input type="hidden" name="RequestId" value="@r.RequestId" />
                            <button type="submit" class="btn-ghost-cafe">
                                <i class="ti ti-x" aria-hidden="true"></i> Reject
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- ── Accounts Table ────────────────────────────────────────── -->
<div class="table-card">

    <div class="table-card-header">
        <div class="table-card-title">
            @(Model.ShowArchived ? "Archived Accounts" : "Staff Accounts") <span>@Model.ListTotal total</span>
        </div>
        <div class="table-tools">
            <div class="search-box">
                <i class="ti ti-search" aria-hidden="true"></i>
                <input type="text" placeholder="Search accounts…" id="searchInput" />
            </div>
            <select class="filter-select" id="roleFilter">
                <option value="">All Roles</option>
                @foreach (var role in Model.Roles)
                {
                    <option value="@role.RoleName">@role.RoleName</option>
                }
            </select>
            @if (!Model.ShowArchived)
            {
                <select class="filter-select" id="statusFilter">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            }
        </div>
    </div>

    <div class="acct-tabs" style="padding:0 16px 12px">
        <a asp-page="./AccountManagement" class="acct-tab @(!Model.ShowArchived ? "active" : "")">
            <i class="ti ti-users" aria-hidden="true"></i> Accounts
        </a>
        <a asp-page="./AccountManagement" asp-route-view="archived" class="acct-tab @(Model.ShowArchived ? "active" : "")">
            <i class="ti ti-archive" aria-hidden="true"></i> Archived
            <span class="tab-count">@Model.ArchivedCount</span>
        </a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Staff Member</th>
                <th>Role</th>
                <th>@(Model.ShowArchived ? "Archived On" : "Date Created")</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var user in Model.Users)
            {
                var roleName = user.Role?.RoleName ?? "—";
                var rejected = user.ApprovalStatus == AccountApproval.Rejected;

                var statusLabel = Model.ShowArchived
                    ? (rejected ? "Rejected" : "Archived")
                    : (user.IsActive ? "Active" : "Inactive");
                var dotClass = (!Model.ShowArchived && user.IsActive) ? "dot-active" : "dot-inactive";

                var shownDate = Model.ShowArchived ? user.ArchivedAt : user.CreatedAt;
                var dateText = shownDate.HasValue ? shownDate.Value.ToString("MMM dd, yyyy") : "—";
                var createdText = user.CreatedAt.HasValue ? user.CreatedAt.Value.ToString("MMM dd, yyyy") : "—";

                <tr data-row>
                    <td>
                        <div class="avatar-cell">
                            <div class="av @AvatarClass(user.UserId)">@Initials(user.FullName)</div>
                            <div>
                                <div class="av-name">@user.FullName</div>
                                <div class="av-email">@user.Username</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="role-badge @RoleClass(roleName)">@roleName</span>
                    </td>
                    <td style="color:var(--text-mute);font-size:13px">@dateText</td>
                    <td>
                        <span class="status-dot">
                            <span class="dot @dotClass"></span> @statusLabel
                        </span>
                    </td>
                    <td>
                        <div class="action-btns">
                            @if (!Model.ShowArchived)
                            {
                                <button class="icon-btn"
                                        title="Edit account"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editAccountModal"
                                        data-userid="@user.UserId"
                                        data-fullname="@user.FullName"
                                        data-username="@user.Username"
                                        data-roleid="@user.RoleId"
                                        data-isactive="@user.IsActive.ToString().ToLower()"
                                        data-contact="@user.ContactNumber"
                                        data-address="@user.Address">
                                    <i class="ti ti-edit" aria-hidden="true"></i>
                                </button>
                            }

                            <button class="icon-btn" title="View account"
                                    data-bs-toggle="modal"
                                    data-bs-target="#viewAccountModal"
                                    data-userid="@user.UserId"
                                    data-fullname="@user.FullName"
                                    data-username="@user.Username"
                                    data-role="@roleName"
                                    data-status="@statusLabel"
                                    data-created="@createdText"
                                    data-contact="@user.ContactNumber"
                                    data-address="@user.Address">
                                <i class="ti ti-eye" aria-hidden="true"></i>
                            </button>

                            @if (Model.ShowArchived)
                            {
                                <form method="post" asp-page-handler="Restore"
                                      data-confirm
                                      data-confirm-title="@(rejected ? "Send back to approval queue" : "Restore account")"
                                      data-confirm-message="@(rejected ? $"Send {user.FullName}'s request back to the approval queue for a new decision?" : $"Restore {user.FullName}? The account stays inactive until you set it to Active in Edit.")"
                                      data-confirm-ok="@(rejected ? "Send back" : "Restore")"
                                      data-confirm-tone="primary"
                                      data-confirm-icon="ti-arrow-back-up">
                                    <input type="hidden" name="UserId" value="@user.UserId" />
                                    <button type="submit" class="icon-btn"
                                            title="@(rejected ? "Send back to approval queue" : "Restore account")">
                                        <i class="ti ti-arrow-back-up" aria-hidden="true"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="icon-btn icon-btn-danger"
                                        title="Archive account"
                                        data-bs-toggle="modal"
                                        data-bs-target="#archiveConfirmModal"
                                        data-userid="@user.UserId"
                                        data-fullname="@user.FullName">
                                    <i class="ti ti-archive" aria-hidden="true"></i>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }

            @* Always present; shown by the server when the list is empty, and by JS when search/filters match nothing *@
            <tr id="noResultsRow" class="no-records-row" style="@(Model.Users.Any() ? "display:none" : "")">
                <td colspan="5">
                    <i class="ti ti-users-off" aria-hidden="true"></i>
                    No records found
                </td>
            </tr>

        </tbody>
    </table>

    @if (showPagination)
    {
        <div class="pagination-bar">
            <p class="pagination-info">
                Showing @Model.PageStart–@Model.PageEnd of @Model.ListTotal accounts
            </p>
            <nav class="pagination-btns" aria-label="Accounts pagination">

                <a asp-page="./AccountManagement"
                   asp-route-pageNumber="@(Model.CurrentPage - 1)"
                   asp-route-view="@viewRoute"
                   class="pg-btn @(Model.CurrentPage <= 1 ? "disabled" : "")"
                   aria-label="Previous page"
                   aria-disabled="@(Model.CurrentPage <= 1 ? "true" : "false")"
                   tabindex="@(Model.CurrentPage <= 1 ? "-1" : "0")">
                    <i class="ti ti-chevron-left" aria-hidden="true"></i>
                </a>

                @if (pgStart > 1)
                {
                    <a asp-page="./AccountManagement" asp-route-pageNumber="1" asp-route-view="@viewRoute" class="pg-btn">1</a>
                    @if (pgStart > 2)
                    {
                        <span class="pg-ellipsis">…</span>
                    }
                }

                @for (int i = pgStart; i <= pgEnd; i++)
                {
                    <a asp-page="./AccountManagement"
                       asp-route-pageNumber="@i"
                       asp-route-view="@viewRoute"
                       class="pg-btn @(i == Model.CurrentPage ? "pg-btn-active" : "")"
                       aria-current="@(i == Model.CurrentPage ? "page" : null)">@i</a>
                }

                @if (pgEnd < Model.TotalPages)
                {
                    @if (pgEnd < Model.TotalPages - 1)
                    {
                        <span class="pg-ellipsis">…</span>
                    }
                    <a asp-page="./AccountManagement" asp-route-pageNumber="@Model.TotalPages" asp-route-view="@viewRoute" class="pg-btn">@Model.TotalPages</a>
                }

                <a asp-page="./AccountManagement"
                   asp-route-pageNumber="@(Model.CurrentPage + 1)"
                   asp-route-view="@viewRoute"
                   class="pg-btn @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                   aria-label="Next page"
                   aria-disabled="@(Model.CurrentPage >= Model.TotalPages ? "true" : "false")"
                   tabindex="@(Model.CurrentPage >= Model.TotalPages ? "-1" : "0")">
                    <i class="ti ti-chevron-right" aria-hidden="true"></i>
                </a>
            </nav>
        </div>
    }

</div>


<!-- ── Add Account Modal ─────────────────────────────────────── -->
<div class="modal fade" id="addAccountModal" tabindex="-1" aria-labelledby="addAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="addAccountModalLabel">
                    <i class="ti ti-user-plus" aria-hidden="true" style="margin-right:6px;color:var(--brown)"></i>
                    Add New Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post" asp-page-handler="Add" data-pw-form
                  data-confirm
                  data-confirm-title="Create account"
                  data-confirm-message="Create the account for {name} and save their contact details on record?"
                  data-confirm-ok="Create account"
                  data-confirm-tone="primary"
                  data-confirm-icon="ti-user-plus">
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div class="form-group">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="FullName" class="form-control-cafe"
                               placeholder="e.g. Juan dela Cruz" required />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Username</label>
                        <input type="text" name="Username" class="form-control-cafe"
                               placeholder="e.g. j.delacruz" required />
                    </div>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                        <div class="form-group">
                            <label class="form-label">Role</label>
                            <select name="RoleId" class="form-control-cafe" required>
                                <option value="">Select role…</option>
                                @foreach (var role in Model.Roles)
                                {
                                    <option value="@role.RoleId">@role.RoleName</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Status</label>
                            <select name="IsActive" class="form-control-cafe">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Contact Number</label>
                        <input type="tel" name="ContactNumber" class="form-control-cafe"
                               data-contact-input
                               placeholder="e.g. 09171234567" required
                               maxlength="11" minlength="11" inputmode="numeric"
                               pattern="[0-9]{11}"
                               title="Contact number must be exactly 11 digits (numbers only)."
                               autocomplete="off" />
                        <p class="pw-match" data-contact-msg aria-live="polite"></p>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Address</label>
                        <textarea name="Address" class="form-control-cafe" rows="2"
                                  placeholder="House no., street, barangay, city" required
                                  minlength="5" maxlength="250"></textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Password</label>
                        <input type="password" name="Password" class="form-control-cafe"
                               placeholder="Create a password" required minlength="8" maxlength="64"
                               autocomplete="new-password" />
                        <ul class="pw-rules" data-pw-rules aria-label="Password requirements"></ul>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" name="ConfirmPassword" class="form-control-cafe"
                               placeholder="Re-enter password" required minlength="8" maxlength="64"
                               autocomplete="new-password" />
                        <p class="pw-match" data-pw-match aria-live="polite"></p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.AddError))
                    {
                        <div class="alert alert-danger mt-2" style="font-size:13px;">
                            <i class="ti ti-alert-circle"></i> @Model.AddError
                        </div>
                    }

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-ghost-cafe" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-cafe">
                        <i class="ti ti-check" aria-hidden="true"></i> Create Account
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>


