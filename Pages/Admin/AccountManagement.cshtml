<!-- ── Reusable Confirmation Modal ───────────────────────────── -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="confirm-body">
                <div class="confirm-icon" id="confirmIcon">
                    <i class="ti ti-help-circle" id="confirmIconI" aria-hidden="true"></i>
                </div>
                <h5 class="confirm-title" id="confirmModalTitle">Are you sure?</h5>
                <p class="confirm-message" id="confirmMessage"></p>
            </div>
            <div class="modal-footer confirm-footer">
                <button type="button" class="btn-ghost-cafe" id="confirmCancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-primary-cafe" id="confirmOk">Confirm</button>
            </div>
        </div>
