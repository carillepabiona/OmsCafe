                               data-contact-input
                               placeholder="e.g. 09171234567" required
                               maxlength="11" minlength="11" inputmode="numeric"
                               pattern="[0-9]{11}"
                               title="Contact number must be exactly 11 digits (numbers only)."
                               autocomplete="off" />
                        <p class="pw-match" data-contact-msg aria-live="polite"></p>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Address</label>
