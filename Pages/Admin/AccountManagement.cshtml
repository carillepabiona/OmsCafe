@section Scripts {
    <script>
        // ── Live search + filter ────────────────────────────────
        document.getElementById('searchInput').addEventListener('input', filterTable);
        document.getElementById('roleFilter').addEventListener('change', filterTable);
        document.getElementById('statusFilter')?.addEventListener('change', filterTable);

        function filterTable() {
            const search = document.getElementById('searchInput').value.trim().toLowerCase();
            const role   = document.getElementById('roleFilter').value.toLowerCase();
            const status = (document.getElementById('statusFilter')?.value || '').toLowerCase();
            const rows   = document.querySelectorAll('.data-table tbody tr[data-row]');
            let visible  = 0;

            rows.forEach(row => {
                const name   = row.querySelector('.av-name')?.textContent.toLowerCase()  || '';
                const email  = row.querySelector('.av-email')?.textContent.toLowerCase() || '';
                const badge  = row.querySelector('.role-badge')?.textContent.trim().toLowerCase() || '';
                const dot    = row.querySelector('.status-dot')?.textContent.trim().toLowerCase() || '';

                const matchSearch = !search || name.includes(search) || email.includes(search);
                const matchRole   = !role   || badge === role;
                const matchStatus = !status || dot === status;

                const show = matchSearch && matchRole && matchStatus;
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            // Show "No records found" inside the table when nothing matches
            document.getElementById('noResultsRow').style.display = visible === 0 ? '' : 'none';
        }

        // ── Contact number: exactly 11 digits, numbers only ─────
        const CONTACT_LENGTH = 11;

        function setupContactInput(input) {
            const msg = input.closest('.form-group')?.querySelector('[data-contact-msg]');

            function update() {
                if (!msg) return;
                const len = input.value.length;
                if (len === 0) {
                    msg.textContent = '';
                    msg.className = 'pw-match';
                } else if (len === CONTACT_LENGTH) {
                    msg.textContent = '✓ ' + CONTACT_LENGTH + ' digits';
                    msg.className = 'pw-match ok';
                } else {
                    msg.textContent = '✕ ' + len + '/' + CONTACT_LENGTH + ' digits (numbers only)';
                    msg.className = 'pw-match bad';
                }
            }

            // Block non-digit keys as they are typed
            input.addEventListener('keypress', function (e) {
                if (e.key.length === 1 && !/[0-9]/.test(e.key)) e.preventDefault();
            });

            // Clean typed / pasted / autofilled values: strip non-digits, cap at 11
            input.addEventListener('input', function () {
                input.value = input.value.replace(/\D/g, '').slice(0, CONTACT_LENGTH);
                update();
            });

            input._contactUpdate = update;
            update();
        }

        document.querySelectorAll('[data-contact-input]').forEach(setupContactInput);

        // ── Password rules (Add + Edit) ─────────────────────────
        // Same rules as the server (PasswordPolicy.cs)
        const PW_RULES = [
            { test: p => p.length >= 8,             label: 'At least 8 characters' },
            { test: p => /[A-Z]/.test(p),           label: 'An uppercase letter (A-Z)' },
            { test: p => /[a-z]/.test(p),           label: 'A lowercase letter (a-z)' },
            { test: p => /[0-9]/.test(p),           label: 'A number (0-9)' },
            { test: p => /[^A-Za-z0-9\s]/.test(p),  label: 'A special character (! @@ # $ % ...)' }
        ];

        function setupPasswordForm(form) {
            const optional = form.hasAttribute('data-pw-optional');   // Edit: blank = keep current password
            const pass     = form.querySelector('[name="Password"]');
            const confirm  = form.querySelector('[name="ConfirmPassword"]');
            const list     = form.querySelector('[data-pw-rules]');
            const match    = form.querySelector('[data-pw-match]');
            const submit   = form.querySelector('button[type="submit"]');

            list.innerHTML = '';
            const items = PW_RULES.map(rule => {
                const li = document.createElement('li');
                const mark = document.createElement('span');
                mark.className = 'pw-mark';
                mark.setAttribute('aria-hidden', 'true');
                const text = document.createElement('span');
                text.textContent = rule.label;
                li.append(mark, text);
                list.appendChild(li);
                return li;
            });

            function check() {
                const p = pass.value;
                const c = confirm.value;
                let allMet = true;

                PW_RULES.forEach((rule, i) => {
                    const met = rule.test(p);
                    if (!met) allMet = false;
                    items[i].classList.toggle('is-met',   p.length > 0 && met);
                    items[i].classList.toggle('is-unmet', p.length > 0 && !met);
                });

                const same = p === c;
                if (!c) {
                    match.textContent = '';
                    match.className = 'pw-match';
                } else if (same) {
                    match.textContent = '✓ Passwords match';
                    match.className = 'pw-match ok';
                } else {
                    match.textContent = '✕ Passwords do not match';
                    match.className = 'pw-match bad';
                }

                const untouched = optional && p === '' && c === '';
                submit.disabled = !untouched && !(allMet && same && p.length > 0);
            }

            pass.addEventListener('input', check);
            confirm.addEventListener('input', check);
            form._pwCheck = check;
            check();
        }

        document.querySelectorAll('[data-pw-form]').forEach(setupPasswordForm);

        // Add modal: start clean every time it closes
        // (skipped when it was only hidden to show the confirmation dialog)
        const addModalEl = document.getElementById('addAccountModal');
        addModalEl.addEventListener('hidden.bs.modal', function () {
            if (addModalEl.dataset.keep === '1') {
                delete addModalEl.dataset.keep;
                return;
            }
            const form = addModalEl.querySelector('form');
            form.reset();
            form._pwCheck();
            form.querySelector('[data-contact-input]')?._contactUpdate();
        });

        // ── Edit modal – pre-fill fields ────────────────────────
        document.getElementById('editAccountModal').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            if (!btn) return;   // re-opened after the confirmation dialog: keep what was typed

            const form = e.currentTarget.querySelector('form');

            document.getElementById('editUserId').value   = btn.dataset.userid;
            document.getElementById('editFullName').value = btn.dataset.fullname;
            document.getElementById('editUsername').value = btn.dataset.username;
            document.getElementById('editRoleId').value   = btn.dataset.roleid;
            document.getElementById('editIsActive').value = btn.dataset.isactive;

            // Older records may contain spaces/dashes: keep digits only so the 11-digit rule can be checked.
            // (Not cut to 11 here, so a bad old number is shown as-is and the admin has to correct it.)
            const editContact = document.getElementById('editContact');
            editContact.value = (btn.dataset.contact || '').replace(/\D/g, '');
            editContact._contactUpdate();

            document.getElementById('editAddress').value  = btn.dataset.address || '';

            form.querySelector('[name="Password"]').value = '';
            form.querySelector('[name="ConfirmPassword"]').value = '';
            form._pwCheck();
        });

        // ── View modal – populate details ───────────────────────
        document.getElementById('viewAccountModal').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            if (!btn) return;

            document.getElementById('viewFullName').textContent = btn.dataset.fullname;
            document.getElementById('viewUsername').textContent = btn.dataset.username;
            document.getElementById('viewRole').textContent     = btn.dataset.role;
            document.getElementById('viewStatus').textContent   = btn.dataset.status;
            document.getElementById('viewContact').textContent  = btn.dataset.contact || '—';
            document.getElementById('viewAddress').textContent  = btn.dataset.address || '—';
            document.getElementById('viewCreated').textContent  = btn.dataset.created;
        });

        // ── Archive modal – populate name & id ──────────────────
        document.getElementById('archiveConfirmModal').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            if (!btn) return;

            document.getElementById('archiveUserId').value         = btn.dataset.userid;
            document.getElementById('archiveFullName').textContent = btn.dataset.fullname;
        });

        // ── Confirmation dialog (replaces the browser's confirm()) ──
        // Any <form data-confirm ...> asks first. Attributes:
        //   data-confirm-title, data-confirm-message ({name} = the form's FullName field),
        //   data-confirm-ok, data-confirm-tone (primary | success | danger), data-confirm-icon (ti-...)
        (function () {
            const el       = document.getElementById('confirmModal');
            const modal    = new bootstrap.Modal(el);
            const iconWrap = document.getElementById('confirmIcon');
            const iconI    = document.getElementById('confirmIconI');
            const titleEl  = document.getElementById('confirmModalTitle');
            const msgEl    = document.getElementById('confirmMessage');
            const okBtn    = document.getElementById('confirmOk');

            let pendingForm = null;
            let parentEl    = null;     // the Add/Edit modal the form lives in, if any
            let confirmed   = false;

            document.addEventListener('submit', function (e) {
                const form = e.target;
                if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-confirm')) return;
                e.preventDefault();
                openConfirm(form);
            });

            function openConfirm(form) {
                pendingForm = form;
                confirmed = false;

                const tone = form.dataset.confirmTone || 'primary';
                const name = (form.querySelector('[name="FullName"]')?.value || 'this staff member').trim();

                titleEl.textContent = form.dataset.confirmTitle || 'Are you sure?';
                msgEl.textContent   = (form.dataset.confirmMessage || '').replace('{name}', name);
                iconI.className     = 'ti ' + (form.dataset.confirmIcon || 'ti-help-circle');
                iconWrap.className  = 'confirm-icon tone-' + tone;
                okBtn.className     = 'btn-primary-cafe tone-' + tone;
                okBtn.textContent   = form.dataset.confirmOk || 'Confirm';
                okBtn.disabled      = false;

                // If the form sits inside another modal, hide that one first (Bootstrap can't stack modals cleanly)
                const parent = form.closest('.modal');
                if (parent && parent.classList.contains('show')) {
                    parentEl = parent;
                    if (parent.id === 'addAccountModal') parent.dataset.keep = '1';   // don't wipe the typed values
                    parent.addEventListener('hidden.bs.modal', () => modal.show(), { once: true });
                    bootstrap.Modal.getInstance(parent).hide();
                } else {
                    parentEl = null;
                    modal.show();
                }
            }

            okBtn.addEventListener('click', function () {
                if (!pendingForm) return;
                confirmed = true;
                okBtn.disabled = true;
                okBtn.textContent = 'Please wait…';
                pendingForm.submit();   // submit() does not fire the submit event again
            });

            // Cancelled / closed: go back to the form the person was filling in
            el.addEventListener('hidden.bs.modal', function () {
                if (!confirmed && parentEl) {
                    bootstrap.Modal.getOrCreateInstance(parentEl).show();
                }
                pendingForm = null;
                parentEl = null;
            });
        })();

        // ── Re-open Add modal on validation error ───────────────
        @if (!string.IsNullOrEmpty(Model.AddError))
        {
                <text>
                    var addModal = new bootstrap.Modal(document.getElementById('addAccountModal'));
                    addModal.show();
                </text>
        }

        // ── Export helpers ──────────────────────────────────────
        function getVisibleRows() {
            return [...document.querySelectorAll('.data-table tbody tr[data-row]')]
                .filter(row => row.style.display !== 'none')
                .map(row => ({
                    FullName:    row.querySelector('.av-name')?.textContent.trim()        ?? '',
                    Username:    row.querySelector('.av-email')?.textContent.trim()       ?? '',
                    Role:        row.querySelector('.role-badge')?.textContent.trim()     ?? '',
                    Status:      row.querySelector('.status-dot')?.textContent.trim()     ?? '',
                    DateCreated: row.cells[2]?.textContent.trim()                         ?? ''
                }));
        }

        function downloadFile(filename, content, mimeType) {
            const blob = new Blob([content], { type: mimeType });
            const url  = URL.createObjectURL(blob);
            const a    = Object.assign(document.createElement('a'), { href: url, download: filename });
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
        }

        document.getElementById('exportCsvBtn').addEventListener('click', function (e) {
            e.preventDefault();
            const rows = getVisibleRows();
            if (!rows.length) { alert('No accounts to export.'); return; }

            const headers = ['Full Name', 'Username', 'Role', 'Status', 'Date'];
            const escape  = v => `"${String(v).replace(/"/g, '""')}"`;
            const csv     = [
                headers.map(escape).join(','),
                ...rows.map(r => [r.FullName, r.Username, r.Role, r.Status, r.DateCreated].map(escape).join(','))
            ].join('\r\n');

            downloadFile(`staff-accounts-${new Date().toISOString().slice(0,10)}.csv`, csv, 'text/csv;charset=utf-8;');
        });

        document.getElementById('exportJsonBtn').addEventListener('click', function (e) {
            e.preventDefault();
            const rows = getVisibleRows();
            if (!rows.length) { alert('No accounts to export.'); return; }

            downloadFile(
                `staff-accounts-${new Date().toISOString().slice(0,10)}.json`,
                JSON.stringify(rows, null, 2),
                'application/json'
            );
        });
    </script>
}
