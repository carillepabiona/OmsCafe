@page
@model OmsCafe.Pages.Cashier.CloseShiftModel
@{
    ViewData["Title"] = "Close Shift";
    ViewData["Subtitle"] = "Count your drawer and submit for manager review";
    string Peso(decimal v) => "₱" + v.ToString("N2");
    var s = Model.Summary;

    // Set by Logout.cshtml.cs when a cashier tries to sign out with an open shift.
    // Reading it here consumes it, so the message only shows once.
    bool logoutBlocked = TempData["LogoutBlocked"] != null;
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/closeshift.css" />

<style>
    /* ═══ Side-by-side layout: Shift summary + Count your drawer ═══ */
    .cs-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        align-items: start;
        width: 100%;
        max-width: 1140px;
    }

    .cs-row > .cs-card { max-width: none; }

    /* On smaller screens, stack them again */
    @@media (max-width: 1100px) {
        .cs-row {
            grid-template-columns: minmax(0, 560px);
        }
    }

    @@media (max-width: 640px) {
        .cs-row { grid-template-columns: minmax(0, 1fr); }
    }

    /* ═══ Submit-shift confirmation popup (kept internal to this page) ═══ */
    .csc-modal[hidden] { display: none !important; }

    .csc-modal {
        position: fixed;
        inset: 0;
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        font-family: 'DM Sans', system-ui, sans-serif;
    }

    .csc-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(40, 24, 10, .55);
        backdrop-filter: blur(3px);
        animation: cscFade .18s ease-out;
    }

    .csc-dialog {
        --csc-color: #15803d;
        --csc-tint: #e7f8ee;
        --csc-border: #a7e3bf;

        position: relative;
        width: 100%;
        max-width: 440px;
        max-height: calc(100vh - 32px);
        overflow-y: auto;
        border-radius: 20px;
        background: var(--white, #fff);
        color: var(--text, #2b2118);
        box-shadow: 0 24px 60px rgba(0, 0, 0, .3);
        animation: cscPop .22s cubic-bezier(.2, .9, .3, 1.1);
        outline: none;
    }

    .csc-dialog[data-state="balanced"] { --csc-color: #15803d; --csc-tint: #e7f8ee; --csc-border: #a7e3bf; }
    .csc-dialog[data-state="short"]    { --csc-color: #b91c1c; --csc-tint: #fef2f2; --csc-border: #fecaca; }
    .csc-dialog[data-state="over"]     { --csc-color: #b45309; --csc-tint: #fff4e5; --csc-border: #f5c98a; }

    /* Header */
    .csc-head {
        padding: 26px 28px 6px;
        text-align: center;
        background: linear-gradient(180deg, var(--csc-tint), transparent);
    }

    .csc-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--white, #fff);
        color: var(--csc-color);
        border: 2px solid var(--csc-border);
        box-shadow: 0 6px 18px rgba(0, 0, 0, .1);
    }

    .csc-icon svg { width: 28px; height: 28px; }
    .csc-ico-warn { display: none; }
    .csc-dialog[data-state="short"] .csc-ico-ok,
    .csc-dialog[data-state="over"]  .csc-ico-ok   { display: none; }
    .csc-dialog[data-state="short"] .csc-ico-warn,
    .csc-dialog[data-state="over"]  .csc-ico-warn { display: block; }

    .csc-head h2 {
        margin: 0 0 4px;
        font-size: 20px;
        font-weight: 800;
        color: var(--espresso, #3b2314);
    }

    .csc-head p {
        margin: 0;
        font-size: 13.5px;
        line-height: 1.5;
        color: var(--text-mute, #8a7a6c);
    }

    /* Big result figure: the one thing the cashier must see */
    .csc-hero {
        margin: 14px 28px 0;
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        border-radius: var(--radius-lg, 14px);
        background: var(--csc-tint);
        border: 1.5px solid var(--csc-border);
    }

    .csc-hero-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--csc-color);
    }

    .csc-hero-value {
        font-size: 32px;
        font-weight: 800;
        line-height: 1.1;
        color: var(--csc-color);
        font-variant-numeric: tabular-nums;
    }

    /* Expected / counted */
    .csc-rows {
        margin: 12px 28px 0;
        padding: 2px 16px;
        border: 1.5px solid var(--border, #eadfd3);
        border-radius: var(--radius-lg, 14px);
        background: var(--warm-50, #fbf7f2);
    }

    .csc-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 11px 0;
        font-size: 14.5px;
    }

    .csc-row + .csc-row { border-top: 1px dashed var(--border, #eadfd3); }
    .csc-row span { color: var(--text-mute, #8a7a6c); }
    .csc-row strong {
        font-weight: 800;
        color: var(--espresso, #3b2314);
        font-variant-numeric: tabular-nums;
    }

    /* The cashier's own explanation, echoed back for review */
    .csc-note {
        margin: 12px 28px 0;
        padding: 10px 12px;
        font-size: 13px;
        line-height: 1.5;
        color: var(--text-sub, #5c4a3b);
        background: var(--warm-100, #f6ede2);
        border-left: 3px solid var(--brown, #ff8c00);
        border-radius: 0 var(--radius, 10px) var(--radius, 10px) 0;
        overflow-wrap: anywhere;
    }

    .csc-note[hidden] { display: none; }
    .csc-note b { display: block; margin-bottom: 2px; color: var(--espresso, #3b2314); }

    .csc-warn {
        margin: 12px 28px 0;
        font-size: 12.5px;
        line-height: 1.5;
        text-align: center;
        color: var(--text-mute, #8a7a6c);
    }

    /* Buttons */
    .csc-actions {
        display: flex;
        gap: 10px;
        padding: 18px 28px 24px;
    }

    .csc-btn {
        flex: 1;
        min-height: 48px;
        padding: 0 18px;
        border: none;
        border-radius: var(--radius, 10px);
        cursor: pointer;
        font: inherit;
        font-size: 15px;
        font-weight: 700;
        transition: filter .15s, transform .05s;
    }

    .csc-btn:active { transform: scale(.98); }
    .csc-btn:focus-visible { outline: 3px solid rgba(255, 140, 0, .4); outline-offset: 2px; }

    .csc-confirm {
        background: var(--brown, #ff8c00);
        color: var(--white, #fff);
        box-shadow: 0 3px 12px rgba(255, 140, 0, .22);
    }
    .csc-confirm:hover { filter: brightness(.93); }

    .csc-cancel {
        background: var(--warm-100, #f6ede2);
        color: var(--text-sub, #5c4a3b);
        border: 1.5px solid var(--border, #eadfd3);
    }
    .csc-cancel:hover { filter: brightness(.96); }

    /* Phones: slide up from the bottom like a sheet, with larger tap targets */
    @@media (max-width: 480px) {
        .csc-modal { align-items: flex-end; padding: 0; }
        .csc-dialog {
            max-width: none;
            border-radius: 20px 20px 0 0;
            max-height: 92vh;
            animation: cscSheet .25s ease-out;
        }
        .csc-actions {
            flex-direction: column-reverse;
            padding-bottom: calc(22px + env(safe-area-inset-bottom, 0px));
        }
        .csc-btn { min-height: 52px; }
    }

    @@keyframes cscPop {
        from { opacity: 0; transform: translateY(8px) scale(.96); }
        to   { opacity: 1; transform: none; }
    }
    @@keyframes cscSheet {
        from { transform: translateY(100%); }
        to   { transform: none; }
    }
    @@keyframes cscFade {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .csc-dialog, .csc-backdrop { animation: none; }
    }
</style>

<div class="cs-page">

@if (logoutBlocked)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert" style="border-radius:12px;">
        <strong>You can't sign out yet.</strong>
        Please count your drawer and close your shift before signing out.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.OpenShift is null)
{
    <section class="cs-card">
        <h2>Start your shift</h2>
        <p class="cs-sub">Count the cash in your drawer and enter it as your opening float.</p>

        <label class="cs-field">
            <span>Opening float</span>
            <div class="cs-input"><b>₱</b>
                <input id="float-input" inputmode="decimal" placeholder="0.00" autocomplete="off" oninput="cleanMoney(this)" />
            </div>
        </label>

        <div id="cs-error" class="cs-error" hidden></div>
        <button type="button" class="cs-btn" id="open-btn" onclick="openShift()">Open shift</button>
    </section>

    @if (Model.LastReport is { } r)
    {
        <section class="cs-card">
            <h2>Last submitted report</h2>
            <p class="cs-sub">Submitted @r.SubmittedAt.ToString("MMM d, h:mm tt")</p>
            <div class="cs-rows">
                <div><span>Expected cash</span><strong>@Peso(r.ExpectedCash)</strong></div>
                <div><span>Counted cash</span><strong>@Peso(r.ActualCash)</strong></div>
                <div><span>Variance</span>
                    <strong class="cs-@r.Result.ToLower()-text">@(r.Variance > 0 ? "+" : r.Variance < 0 ? "−" : "")@Peso(Math.Abs(r.Variance))</strong></div>
                <div><span>Result</span><span class="cs-pill cs-@r.Result.ToLower()">@r.Result</span></div>
                <div><span>Review</span><strong>@(r.ReviewedAt == null ? "Pending manager review" : "Reviewed " + r.ReviewedAt.Value.ToString("MMM d, h:mm tt"))</strong></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(r.Explanation))
            {
                <div class="cs-note"><b>Your explanation:</b> @r.Explanation</div>
            }
            @if (!string.IsNullOrWhiteSpace(r.ManagerNotes))
            {
                <div class="cs-note"><b>Manager notes:</b> @r.ManagerNotes</div>
            }
        </section>
    }
}
else
{
    <div class="cs-row">
    <section class="cs-card">
        <h2>Shift summary</h2>
        <p class="cs-sub">Opened @Model.OpenShift.OpenedAt.ToString("MMM d, h:mm tt") · @Model.OpenShift.CashierName</p>

        <div class="cs-grid">
            <div class="cs-stat"><span>Opening float</span><strong id="s-float">@Peso(s!.OpeningFloat)</strong></div>
            <div class="cs-stat"><span>Cash sales (<span id="s-orders">@s.CashOrders</span> orders)</span><strong id="s-cash">@Peso(s.CashSales)</strong></div>
            <div class="cs-stat cs-stat-main"><span>Expected cash in drawer</span><strong id="s-expected">@Peso(s.ExpectedCash)</strong></div>
            <div class="cs-stat cs-stat-mute"><span>Non-cash payments (not in drawer)</span><strong id="s-noncash">@Peso(s.NonCashSales)</strong></div>
        </div>
    </section>

    <section class="cs-card">
        <h2>Count your drawer</h2>
        <p class="cs-sub">Count all bills and coins, then enter the total.</p>

        <label class="cs-field">
            <span>Actual cash counted</span>
            <div class="cs-input"><b>₱</b>
                <input id="count-input" inputmode="decimal" placeholder="0.00" autocomplete="off" oninput="onCount()" />
            </div>
        </label>

        <div class="cs-result" id="cs-result" data-state="idle">
            <span class="cs-result-label" id="r-label">Drawer status</span>
            <span class="cs-result-value" id="r-value">—</span>
            <span class="cs-result-hint" id="r-hint">Enter the counted amount to compare.</span>
        </div>

        <label class="cs-field" id="explain-wrap" hidden>
            <span>Explain the discrepancy <em>(required)</em></span>
            <textarea id="explain" rows="3" maxlength="500"
                      placeholder="e.g. Gave wrong change to a customer at 2:15 PM, or a bill was miscounted."
                      oninput="onCount()"></textarea>
        </label>

        <div id="cs-error" class="cs-error" hidden></div>
        <button type="button" class="cs-btn" id="submit-btn" onclick="submitShift()" disabled>Submit shift report</button>
        <p class="cs-fine">You can't edit the report after submitting. A manager will review it.</p>
    </section>
    </div>

    @* ── Confirmation popup (replaces the browser's confirm() box) ── *@
    <div id="csc-modal" class="csc-modal" hidden>
        <div class="csc-backdrop" onclick="resolveConfirm(false)"></div>
        <div id="csc-dialog" class="csc-dialog" data-state="balanced" tabindex="-1"
             role="alertdialog" aria-modal="true" aria-labelledby="csc-title" aria-describedby="csc-msg">

            <div class="csc-head">
                <div class="csc-icon" aria-hidden="true">
                    <svg class="csc-ico-ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                        <path d="M8 12l3 3 5-6"></path>
                    </svg>
                    <svg class="csc-ico-warn" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>
                        <path d="M12 9v4"></path>
                        <path d="M12 17h.01"></path>
                    </svg>
                </div>
                <h2 id="csc-title">Submit shift report?</h2>
                <p id="csc-msg">Please check the numbers before you submit.</p>
            </div>

            <div class="csc-hero" aria-live="polite">
                <span class="csc-hero-label" id="csc-label">Balanced</span>
                <span class="csc-hero-value" id="csc-value">₱0.00</span>
            </div>

            <div class="csc-rows">
                <div class="csc-row"><span>Expected cash</span><strong id="csc-expected">—</strong></div>
                <div class="csc-row"><span>Counted cash</span><strong id="csc-counted">—</strong></div>
            </div>

            <div class="csc-note" id="csc-note" hidden>
                <b>Your explanation</b>
                <span id="csc-note-text"></span>
            </div>

            <p class="csc-warn">You can't edit the report after submitting.</p>

            <div class="csc-actions">
                <button type="button" class="csc-btn csc-cancel" id="csc-cancel" onclick="resolveConfirm(false)">Go back</button>
                <button type="button" class="csc-btn csc-confirm" id="csc-ok" onclick="resolveConfirm(true)">Submit report</button>
            </div>
        </div>
    </div>
}
</div>

@Html.AntiForgeryToken()

<script>
    const byId = id => document.getElementById(id);
    const toCents = v => Math.round((parseFloat(v) || 0) * 100);
    const pesoC = c => '₱' + (c / 100).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const pesoV = v => pesoC(Math.round(v * 100));
    const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    function cleanMoney(el) {
        el.value = el.value.replace(/[^\d.]/g, '').replace(/^(\d*\.?\d{0,2}).*$/, '$1');
    }
    function showError(msg) { const e = byId('cs-error'); e.textContent = msg; e.hidden = !msg; }

    async function post(handler, body) {
        const res = await fetch('?handler=' + handler, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify(body)
        });
        if (res.status === 401) { location.href = '/Login'; return null; }
        if (!res.ok) throw new Error('Server returned ' + res.status);
        return res.json();
    }

    // ── Open shift ──
    async function openShift() {
        const input = byId('float-input');
        if (input.value.trim() === '') { showError('Enter your opening float (0 if the drawer is empty).'); return; }
        showError('');
        const btn = byId('open-btn'); btn.disabled = true;
        try {
            const data = await post('Open', { openingFloat: toCents(input.value) / 100 });
            if (!data) return;
            if (data.success) location.reload();
            else { showError(data.message); btn.disabled = false; }
        } catch (e) { showError('Network error. Please try again.'); btn.disabled = false; }
    }

    // ── Close shift ──
    const SHIFT_ID = @(Model.OpenShift?.Id ?? 0);
    let expectedCents = @(s is null ? 0 : (long)decimal.Round(s.ExpectedCash * 100));

    function onCount() {
        const input = byId('count-input');
        if (!input) return;
        cleanMoney(input);

        const has = input.value.trim() !== '';
        const actual = toCents(input.value);
        const variance = actual - expectedCents;
        const box = byId('cs-result'), label = byId('r-label'), value = byId('r-value'), hint = byId('r-hint');
        const wrap = byId('explain-wrap');
        let state;

        if (!has) {
            state = 'idle'; label.textContent = 'Drawer status'; value.textContent = '—';
            hint.textContent = 'Enter the counted amount to compare.';
        } else if (variance === 0) {
            state = 'balanced'; label.textContent = 'Balanced'; value.textContent = pesoC(0);
            hint.textContent = 'Counted cash matches expected cash.';
        } else if (variance < 0) {
            state = 'short'; label.textContent = 'Short by'; value.textContent = pesoC(-variance);
            hint.textContent = `Expected ${pesoC(expectedCents)}, counted ${pesoC(actual)}.`;
        } else {
            state = 'over'; label.textContent = 'Over by'; value.textContent = pesoC(variance);
            hint.textContent = `Expected ${pesoC(expectedCents)}, counted ${pesoC(actual)}.`;
        }
        box.dataset.state = state;

        const needsExplain = has && variance !== 0;
        wrap.hidden = !needsExplain;
        const explained = byId('explain').value.trim().length >= 5;
        byId('submit-btn').disabled = !has || (needsExplain && !explained);
    }

    function applyExpected(d) {
        expectedCents = Math.round(d.expectedCash * 100);
        byId('s-cash').textContent = pesoV(d.cashSales);
        byId('s-orders').textContent = d.cashOrders;
        byId('s-noncash').textContent = pesoV(d.nonCashSales);
        byId('s-expected').textContent = pesoV(d.expectedCash);
        onCount();
    }

    // ── Confirmation popup ──
    let confirmResolver = null;
    let lastFocus = null;

    function askConfirm(expected, counted, variance, explanation) {
        const state = variance === 0 ? 'balanced' : variance < 0 ? 'short' : 'over';

        byId('csc-dialog').dataset.state = state;
        byId('csc-label').textContent = variance === 0 ? 'Balanced' : variance < 0 ? 'Short by' : 'Over by';
        byId('csc-value').textContent = pesoC(Math.abs(variance));
        byId('csc-expected').textContent = pesoC(expected);
        byId('csc-counted').textContent = pesoC(counted);

        const note = byId('csc-note');
        note.hidden = !(variance !== 0 && explanation);
        byId('csc-note-text').textContent = explanation || '';

        lastFocus = document.activeElement;
        document.body.style.overflow = 'hidden';
        byId('csc-modal').hidden = false;

        // Money + irreversible: start on "Go back" so a stray Enter can't submit.
        byId('csc-cancel').focus();

        return new Promise(resolve => { confirmResolver = resolve; });
    }

    function resolveConfirm(answer) {
        byId('csc-modal').hidden = true;
        document.body.style.overflow = '';
        if (lastFocus && lastFocus.focus) lastFocus.focus();
        if (confirmResolver) { confirmResolver(answer); confirmResolver = null; }
    }

    document.addEventListener('keydown', e => {
        const modal = byId('csc-modal');
        if (!modal || modal.hidden) return;

        if (e.key === 'Escape') { resolveConfirm(false); return; }

        // Keep Tab inside the popup
        if (e.key === 'Tab') {
            const items = [byId('csc-cancel'), byId('csc-ok')];
            const first = items[0], last = items[items.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
    });

    async function submitShift() {
        const actual = toCents(byId('count-input').value);
        const variance = actual - expectedCents;
        const explanation = byId('explain').value.trim();

        const ok = await askConfirm(expectedCents, actual, variance, explanation);
        if (!ok) return;

        showError('');
        const btn = byId('submit-btn'); btn.disabled = true; btn.textContent = 'Submitting…';
        try {
            const data = await post('Submit', {
                shiftId: SHIFT_ID,
                actualCash: actual / 100,
                expectedShown: expectedCents / 100,
                explanation: explanation
            });
            if (!data) return;
            if (data.success) { location.reload(); return; }

            showError(data.message);
            if (data.expectedCash != null) { expectedCents = Math.round(data.expectedCash * 100); refreshSummary(); }
        } catch (e) { showError('Network error. Please try again.'); }
        btn.textContent = 'Submit shift report';
        onCount();
    }

    async function refreshSummary() {
        try {
            const res = await fetch('?handler=Summary');
            if (!res.ok) return;
            const d = await res.json();
            if (d.success) applyExpected(d);
        } catch (e) { }
    }

    if (SHIFT_ID) setInterval(refreshSummary, 20000);
</script>
