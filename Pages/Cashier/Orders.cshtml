@page
@model OmsCafe.Pages.Cashier.OrdersModel
@functions {
    // "Waiting Payment" -> "waiting-payment" (safe for CSS classes and classList)
    static string Slug(string s) => (s ?? "").Trim().ToLower().Replace(' ', '-');

    // verified type wins, then what the customer requested, else Regular
    static string CustTypeOf(string discountType, string discountRequest) =>
        !string.IsNullOrEmpty(discountType)
            ? discountType
            : (discountRequest == "PWD" || discountRequest == "Senior") ? discountRequest : "Regular";
}
@{
    ViewData["Title"] = "Order Management";
    ViewData["Subtitle"] = "Manage all active orders in real-time";

    // ── Discount overview numbers (active orders only) ──
    var dsActive = Model.AllOrders
        .Where(o => !OmsCafe.Pages.Cashier.OrdersModel.IsCompleted(o.Status) && o.Status != "cancelled")
        .ToList();
    var dsRegular = dsActive.Count(o => CustTypeOf(o.DiscountType, o.DiscountRequest) == "Regular");
    var dsSenior = dsActive.Count(o => CustTypeOf(o.DiscountType, o.DiscountRequest) == "Senior");
    var dsPwd = dsActive.Count(o => CustTypeOf(o.DiscountType, o.DiscountRequest) == "PWD");
    var dsGiven = Model.AllOrders
        .Where(o => o.Status != "cancelled" && !string.IsNullOrEmpty(o.DiscountType))
        .Sum(o => o.DiscountAmount);
    var dsPending = dsActive
        .Where(o => o.Status == "Waiting Payment"
                    && string.IsNullOrEmpty(o.DiscountType)
                    && (o.DiscountRequest == "PWD" || o.DiscountRequest == "Senior"))
        .ToList();

}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/orders.css" asp-append-version="true" />

<style>
    /* ── TAKE-OUT CUSTOMER TYPE CHOOSER (Regular / Senior / PWD) ── */
    .tk-type[hidden], .tk-fields[hidden], .tk-regular-note[hidden] { display: none !important; }
    .tk-type { margin: 0 0 14px; }
    .tk-type-label { display: block; font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; opacity: .7; margin-bottom: 6px; }
    .tk-seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .tk-opt { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 56px; padding: 8px 6px; border: 1.5px solid rgba(128, 128, 128, .35); border-radius: 12px; background: transparent; color: inherit; font: inherit; font-weight: 600; font-size: 14px; cursor: pointer; transition: border-color .15s, background .15s, transform .05s; }
    .tk-opt small { font-weight: 400; font-size: 11px; opacity: .65; }
    .tk-opt:hover:not(:disabled) { border-color: rgba(128, 128, 128, .7); }
    .tk-opt:active:not(:disabled) { transform: scale(.98); }
    .tk-opt:focus-visible { outline: 2px solid #4f8cff; outline-offset: 2px; }
    .tk-opt.active { border-color: #2f7d4f; background: rgba(47, 125, 79, .12); }
    .tk-opt.active[data-type="Senior"] { border-color: #c27a12; background: rgba(194, 122, 18, .12); }
    .tk-opt.active[data-type="PWD"] { border-color: #2f6bd6; background: rgba(47, 107, 214, .12); }
    .tk-opt:disabled { opacity: .55; cursor: not-allowed; }
    .tk-lock-hint { margin: 6px 0 0; font-size: 12px; opacity: .7; }
    .tk-fields { display: flex; flex-direction: column; gap: 10px; margin-top: 12px; }
    .tk-regular-note { margin-top: 12px; padding: 12px; border-radius: 12px; background: rgba(47, 125, 79, .1); font-size: 14px; }
    .tk-regular-note p { margin: 0 0 10px; }

    /* ── TAKE-OUT QUICK TYPE ROW (on the order card) ── */
    .tk-quick { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin: 10px 0 4px; }
    .tk-quick-btn { padding: 7px 4px; border: 1.5px solid rgba(128, 128, 128, .35); border-radius: 10px; background: transparent; color: inherit; font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer; transition: border-color .15s, background .15s; }
    .tk-quick-btn:hover { border-color: rgba(128, 128, 128, .75); }
    .tk-quick-btn:focus-visible { outline: 2px solid #4f8cff; outline-offset: 2px; }
    .tk-quick-btn.active[data-type="Regular"] { border-color: #2f7d4f; background: rgba(47, 125, 79, .12); }
    .tk-quick-btn.active[data-type="Senior"] { border-color: #c27a12; background: rgba(194, 122, 18, .12); }
    .tk-quick-btn.active[data-type="PWD"] { border-color: #2f6bd6; background: rgba(47, 107, 214, .12); }

    /* ── DISCOUNT OVERVIEW SECTION ── */
    .ds-section { margin: 0 0 18px; padding: 16px; border: 1.5px solid rgba(128, 128, 128, .25); border-radius: 16px; }
    .ds-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
    .ds-head h3 { margin: 0; font-size: 16px; }
    .ds-sub { font-size: 12px; opacity: .65; }
    .ds-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; }
    .ds-chip, .ds-stat { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 10px 12px; border: 1.5px solid rgba(128, 128, 128, .3); border-radius: 12px; background: transparent; color: inherit; font: inherit; font-size: 13px; text-align: left; }
    .ds-chip { cursor: pointer; transition: border-color .15s, background .15s; }
    .ds-chip:hover { border-color: rgba(128, 128, 128, .7); }
    .ds-chip:focus-visible { outline: 2px solid #4f8cff; outline-offset: 2px; }
    .ds-chip.active { border-color: #2f7d4f; background: rgba(47, 125, 79, .12); }
    .ds-chip.active[data-ctf="Senior"] { border-color: #c27a12; background: rgba(194, 122, 18, .12); }
    .ds-chip.active[data-ctf="PWD"] { border-color: #2f6bd6; background: rgba(47, 107, 214, .12); }
    .ds-n { font-size: 20px; font-weight: 700; line-height: 1.1; }
    .ds-pending[hidden] { display: none !important; }
    .ds-pending { margin-top: 12px; padding: 12px; border-radius: 12px; background: rgba(194, 122, 18, .12); }
    .ds-pending-title { font-size: 13px; font-weight: 600; margin-bottom: 8px; }
    .ds-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 6px 0; font-size: 13px; border-top: 1px solid rgba(128, 128, 128, .2); }
    .ds-item:first-child { border-top: 0; }
    .ds-item-btn { padding: 6px 12px; border: 1.5px solid currentColor; border-radius: 10px; background: transparent; color: inherit; font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer; white-space: nowrap; }

    /* cards hidden by the customer-type filter */
    .order-card.ct-hidden { display: none !important; }

    /* ── NO OPEN SHIFT POPUP ── */
    .ns-modal {
        --ns-bg: #ffffff; --ns-text: #1f2430; --ns-muted: #6b7280; --ns-line: rgba(0, 0, 0, .08);
        --ns-soft: #f6f7f9; --ns-accent: #c27a12; --ns-accent-soft: rgba(194, 122, 18, .14);
        --ns-primary: #2f7d4f; --ns-primary-hover: #276b43;
        position: fixed; inset: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 16px;
    }
    @@media (prefers-color-scheme: dark) {
        .ns-modal { --ns-bg: #1c2029; --ns-text: #f1f3f7; --ns-muted: #9aa3b2; --ns-line: rgba(255, 255, 255, .1); --ns-soft: #252a35; --ns-accent: #e0a23c; --ns-accent-soft: rgba(224, 162, 60, .16); --ns-primary: #3a9a62; --ns-primary-hover: #34885a; }
    }
    .ns-modal[hidden] { display: none !important; }
    .ns-backdrop { position: absolute; inset: 0; background: rgba(15, 18, 25, .55); backdrop-filter: blur(3px); animation: nsFade .2s ease-out; }
    .ns-dialog { position: relative; width: 100%; max-width: 440px; overflow: hidden; border-radius: 20px; background: var(--ns-bg); color: var(--ns-text); box-shadow: 0 24px 60px rgba(0, 0, 0, .35); animation: nsPop .22s cubic-bezier(.2, .9, .3, 1.1); font-family: 'DM Sans', system-ui, sans-serif; }
    .ns-close { position: absolute; top: 12px; right: 12px; width: 32px; height: 32px; border: 0; border-radius: 50%; background: rgba(0, 0, 0, .06); color: var(--ns-muted); font-size: 20px; line-height: 1; cursor: pointer; z-index: 1; transition: background .15s, color .15s; }
    .ns-close:hover { background: rgba(0, 0, 0, .12); color: var(--ns-text); }
    .ns-hero { display: flex; justify-content: center; padding: 32px 24px 8px; background: linear-gradient(180deg, var(--ns-accent-soft), transparent); }
    .ns-icon { position: relative; width: 76px; height: 76px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--ns-bg); color: var(--ns-accent); box-shadow: 0 6px 18px rgba(0, 0, 0, .12); }
    .ns-icon::after { content: ""; position: absolute; inset: -8px; border-radius: 50%; border: 2px solid var(--ns-accent); opacity: 0; animation: nsPulse 2.2s ease-out infinite; }
    .ns-icon svg { width: 36px; height: 36px; }
    .ns-body { padding: 12px 28px 4px; text-align: center; }
    .ns-tag { display: inline-block; margin-bottom: 8px; padding: 3px 10px; border-radius: 999px; background: var(--ns-accent-soft); color: var(--ns-accent); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
    .ns-dialog h2 { margin: 0 0 8px; font-family: 'Syne', 'DM Sans', system-ui, sans-serif; font-size: 22px; font-weight: 700; }
    .ns-dialog p { margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--ns-muted); }
    .ns-steps { list-style: none; margin: 18px 0 0; padding: 12px 14px; display: flex; flex-direction: column; gap: 10px; border-radius: 14px; background: var(--ns-soft); border: 1px solid var(--ns-line); text-align: left; font-size: 13.5px; }
    .ns-steps li { display: flex; align-items: center; gap: 10px; }
    .ns-steps li span { flex: none; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--ns-accent); color: #fff; font-size: 12px; font-weight: 700; }
    .ns-actions { display: flex; flex-direction: column; gap: 8px; padding: 20px 28px 24px; }
    .ns-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 0 18px; border: 0; border-radius: 12px; font: inherit; font-size: 15px; font-weight: 600; text-decoration: none; cursor: pointer; transition: background .15s, transform .05s; }
    .ns-btn:active { transform: scale(.98); }
    .ns-btn:focus-visible, .ns-close:focus-visible { outline: 2px solid #4f8cff; outline-offset: 2px; }
    .ns-btn svg { width: 18px; height: 18px; }
    .ns-btn-primary { background: var(--ns-primary); color: #fff; }
    .ns-btn-primary:hover { background: var(--ns-primary-hover); color: #fff; }
    .ns-btn-ghost { background: transparent; color: var(--ns-muted); min-height: 40px; font-weight: 500; }
    .ns-btn-ghost:hover { color: var(--ns-text); background: var(--ns-soft); }
    @@keyframes nsPop { from { opacity: 0; transform: translateY(8px) scale(.96); } to { opacity: 1; transform: none; } }
    @@keyframes nsFade { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes nsPulse { 0% { opacity: .5; transform: scale(.9); } 100% { opacity: 0; transform: scale(1.25); } }
    @@media (prefers-reduced-motion: reduce) { .ns-dialog, .ns-backdrop, .ns-icon::after { animation: none; } }
</style>

<!-- ── CALL STAFF NOTIFICATION BANNER ── -->
<div id="staff-notif-banner" style="display:none;" role="alert">
    <div class="staff-notif-inner">
        <span class="staff-notif-icon"><i class="fa-solid fa-bell"></i></span>
        <div class="staff-notif-text">
            <strong id="staff-notif-title">Customer is calling for staff</strong>
            <span id="staff-notif-sub"></span>
        </div>
        <button type="button" class="staff-notif-ack" onclick="acknowledgeCallStaff()">✓ Acknowledge</button>
        <button type="button" class="staff-notif-dismiss" onclick="dismissNotif()" aria-label="Dismiss">✕</button>
    </div>
</div>

<!-- ── CALL STAFF TOAST STACK ── -->
<div id="staff-toast-stack"></div>

<div class="orders-page">
    <!-- Header -->
    <div class="orders-header">
        <div class="header-stats">
            <div class="stat-badge">
                <span class="stat-label">Total Orders</span>
                <span class="stat-value" id="hdr-total">@Model.AllOrders.Count(o => o.Status != "cancelled")</span>
            </div>
            <div class="stat-badge">
                <span class="stat-label">In Progress</span>
                <span class="stat-value" id="hdr-inprogress">
                    @Model.AllOrders.Count(o => o.Status == "pending"
                        || o.Status == "preparing"
                        || o.Status == "ready")
                </span>
            </div>
            <div class="stat-badge">
                <span class="stat-label">Ready</span>
                <span class="stat-value" id="hdr-ready">@Model.AllOrders.Count(o => o.Status == "ready")</span>
            </div>
            <!-- Staff call indicator -->
            <button type="button" class="stat-badge stat-badge-alert" id="staff-call-badge" style="display:none;" onclick="showStaffBanner()">
                <span class="stat-label"><i class="fa-solid fa-bell"></i> Staff Calls</span>
                <span class="stat-value" id="staff-call-count">0</span>
            </button>
        </div>
    </div>

    <!-- Search + filters -->
    <form method="get" id="filterForm">
        <div class="search-filters-section">
            <div class="search-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input type="search"
                       id="search-input"
                       name="searchQuery"
                       value="@Model.SearchQuery"
                       placeholder="Search by order #, table or item"
                       aria-label="Search orders"
                       oninput="debouncedSearch(this)" />
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <a class="search-clear"
                       asp-page="/Cashier/Orders"
                       asp-route-selectedTab="@Model.SelectedTab"
                       asp-route-selectedFilter="@Model.SelectedFilter"
                       aria-label="Clear search">✕</a>
                }
            </div>
            <input type="hidden" name="selectedTab" value="@Model.SelectedTab" />
            <input type="hidden" name="selectedFilter" value="@Model.SelectedFilter" />

            @if (Model.SelectedTab != "completed")
            {
                <div class="filter-buttons" role="group" aria-label="Filter by status">
                    @foreach (var f in new[] {
                        ("all", "All Status"),
                        ("Waiting Payment", "Waiting Payment"),
                        ("pending", "Pending"),
                        ("preparing", "Preparing"),
                        ("ready", "Ready") })
                    {
                        <a asp-page="/Cashier/Orders"
                           asp-route-selectedTab="@Model.SelectedTab"
                           asp-route-selectedFilter="@f.Item1"
                           asp-route-searchQuery="@Model.SearchQuery"
                           class="filter-btn @(Model.SelectedFilter == f.Item1 ? "active" : "")">@f.Item2</a>
                    }
                </div>
            }
        </div>
    </form>

    <!-- Tabs -->
    <div class="tabs-section" role="tablist">
        @foreach (var tab in new[] {
            ("all", "All Orders"),
            ("dine-in", "Dine-In"),
            ("take-out", "Take-Out"),
            ("completed", "Completed") })
        {
            <a asp-page="/Cashier/Orders"
               asp-route-selectedTab="@tab.Item1"
               asp-route-selectedFilter="all"
               asp-route-searchQuery="@Model.SearchQuery"
               role="tab"
               aria-selected="@(Model.SelectedTab == tab.Item1 ? "true" : "false")"
               class="tab-btn @(Model.SelectedTab == tab.Item1 ? "active" : "")">
                @if (tab.Item1 == "all")
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                }
                else if (tab.Item1 == "dine-in")
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M6 9l12 0"></path>
                        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                        <path d="M5 21h14"></path>
                    </svg>
                }
                else if (tab.Item1 == "take-out")
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                }
                <span>@tab.Item2</span>
                <span class="tab-badge" id="tab-badge-@tab.Item1">@Model.CountFor(tab.Item1)</span>
            </a>
        }
    </div>

    <!-- ══════════════ DISCOUNTS & CUSTOMER TYPES ══════════════ -->
    @* @if (Model.SelectedTab != "completed")
    {
        <section class="ds-section" id="discount-overview" aria-label="Discounts and customer types">
            <div class="ds-head">
                <h3>Discounts &amp; Customer Types</h3>
                <span class="ds-sub">Active orders · tap a type to filter the list</span>
            </div>

            <div class="ds-grid">
                <button type="button" class="ds-chip active" data-ctf="all" onclick="applyCustomerFilter('all')">
                    <span class="ds-n" id="ds-all">@dsActive.Count</span><span>All</span>
                </button>
                <button type="button" class="ds-chip" data-ctf="Regular" onclick="applyCustomerFilter('Regular')">
                    <span class="ds-n" id="ds-regular">@dsRegular</span><span>👤 Regular</span>
                </button>
                <button type="button" class="ds-chip" data-ctf="Senior" onclick="applyCustomerFilter('Senior')">
                    <span class="ds-n" id="ds-senior">@dsSenior</span><span>🪪 Senior</span>
                </button>
                <button type="button" class="ds-chip" data-ctf="PWD" onclick="applyCustomerFilter('PWD')">
                    <span class="ds-n" id="ds-pwd">@dsPwd</span><span>🪪 PWD</span>
                </button>
                <div class="ds-stat">
                    <span class="ds-n" id="ds-given">₱@dsGiven.ToString("N2")</span>
                    <span>Discount given</span>
                </div>
            </div>

            <div class="ds-pending" id="ds-pending" @(dsPending.Any() ? "" : "hidden")>
                <div class="ds-pending-title">⚠ <span id="ds-pending-count">@dsPending.Count</span> waiting for ID verification</div>
                <div id="ds-pending-list">
                    @foreach (var p in dsPending)
                    {
                        <div class="ds-item">
                            <span>
                                <strong>#@p.OrderNumber</strong>
                                · @(p.Type == "take-out" ? "Take-Out" : "Dine-In")
                                · requested @p.DiscountRequest
                            </span>
                            <button type="button" class="ds-item-btn" onclick="verifyFromList(@p.Id)">Verify ID</button>
                        </div>
                    }
                </div>
            </div>
        </section>
    } *@

    <!-- Orders Grid -->
    <div class="orders-list-section">
        <div class="empty-state" id="empty-state" style="@(Model.OrdersFiltered.Any() ? "display:none" : "")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"></path>
            </svg>
            <p>No orders here</p>
            <span class="empty-hint">
                @(string.IsNullOrWhiteSpace(Model.SearchQuery)
                    ? "New orders show up automatically."
                    : "Nothing matches your search. Try a different order number, table or item.")
            </span>
        </div>

        <div class="orders-grid" id="orders-grid">
            @foreach (var order in Model.OrdersFiltered)
            {
                @* Customer type: verified type wins, then what the customer requested, else Regular *@
                var custType = !string.IsNullOrEmpty(order.DiscountType)
                    ? order.DiscountType
                    : (order.DiscountRequest == "PWD" || order.DiscountRequest == "Senior")
                        ? order.DiscountRequest
                        : "Regular";
                var custVerified = !string.IsNullOrEmpty(order.DiscountType);

                <div class="order-card order-@Slug(order.Status)"
                     id="order-card-@order.Id"
                     data-status="@order.Status"
                     data-type="@order.Type"
                     data-customer-type="@custType"
                     tabindex="0"
                     role="button"
                     aria-label="Open order @order.OrderNumber"
                     onclick="openPanel(@order.Id)"
                     onkeydown="if (event.key === 'Enter' && event.target === this) openPanel(@order.Id)">
                    <div class="order-card-header">
                        <div class="oc-title">
                            <span class="order-number">#@order.OrderNumber</span>
                            <span class="order-customer">@order.CustomerName</span>
                        </div>
                        <span class="order-status-badge @Slug(order.Status)"
                              id="status-badge-@order.Id">@order.Status</span>
                    </div>

                    <div class="order-card-content">
                        <div class="order-tags">
                            <span class="order-type-badge @order.Type">
                                @if (order.Type == "dine-in")
                                {
                                    <text><i class="fa-solid fa-utensils"></i> Dine-In</text>
                                }
                                else
                                {
                                    <text><i class="fa-solid fa-bag-shopping"></i> Take-Out</text>
                                }
                            </span>
                            <span class="customer-badge ct-@custType.ToLower()">
                                @(custType == "Regular" ? "👤" : "🪪") @custType
                            </span>
                        </div>

                        <div class="order-details-grid">
                            @if (!string.IsNullOrEmpty(order.Table))
                            {
                                <div class="detail-item">
                                    <span class="detail-label">Table</span>
                                    <span class="detail-value">@order.Table</span>
                                </div>
                            }
                            <div class="detail-item">
                                <span class="detail-label">Items</span>
                                <span class="detail-value">@order.ItemCount</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Time</span>
                                <span class="detail-value time-badge" id="elapsed-@order.Id">@order.ElapsedTime</span>
                            </div>
                        </div>

                        @* ── Discount status (Regular shows nothing extra) ── *@
                        @if (custVerified)
                        {
                            <div class="discount-note ok">
                                ✔ @order.DiscountType verified (−₱@order.DiscountAmount.ToString("0.00"))
                            </div>
                        }
                        else if (custType != "Regular")
                        {
                            <div class="discount-note warn">
                                ⚠ @custType requested. Verify ID before payment.
                            </div>
                        }

                        @* ── TAKE-OUT ONLY: quick customer type row ── *@
                        @if (order.Type == "take-out" && order.Status == "Waiting Payment" && !custVerified)
                        {
                            <div class="tk-quick" id="tk-quick-@order.Id" role="group" aria-label="Customer type" onclick="event.stopPropagation()">
                                <button type="button" class="tk-quick-btn @(custType == "Regular" ? "active" : "")" data-type="Regular"
                                        onclick="event.stopPropagation(); tkQuick(@order.Id, 'Regular')">
                                    👤 Regular
                                </button>
                                <button type="button" class="tk-quick-btn @(custType == "Senior" ? "active" : "")" data-type="Senior"
                                        onclick="event.stopPropagation(); tkQuick(@order.Id, 'Senior')">
                                    🪪 Senior
                                </button>
                                <button type="button" class="tk-quick-btn @(custType == "PWD" ? "active" : "")" data-type="PWD"
                                        onclick="event.stopPropagation(); tkQuick(@order.Id, 'PWD')">
                                    🪪 PWD
                                </button>
                            </div>
                        }

                        @if (order.Status == "printing")
                        {
                            <div class="print-indicator" id="print-ind-@order.Id">
                                <span class="print-indicator-dot"></span> Printing receipt…
                            </div>
                        }

                        <div class="items-preview">
                            @foreach (var item in order.Items.Take(2))
                            {
                                <div class="item-preview">
                                    <span class="item-qty">@item.Quantity×</span>
                                    <span class="item-name">@item.Name</span>
                                </div>
                            }
                            @if (order.Items.Count > 2)
                            {
                                <div class="items-more">+@(order.Items.Count - 2) more items</div>
                            }
                        </div>
                    </div>

                    <div class="order-card-footer">
                        <div class="order-price">
                            <span class="price-label">Total</span>
                            <span class="price-value">₱@order.Total.ToString("0.00")</span>
                        </div>
                        <div class="card-actions">
                            @if (order.Status == "Waiting Payment")
                            {
                                <button type="button" class="btn-quick-pay" id="quick-pay-@order.Id"
                                        onclick="event.stopPropagation(); openPayModal(@order.Id);">
                                    <i class="fa-solid fa-peso-sign"></i> Mark as Paid
                                </button>
                            }
                            <a class="btn-view" href="#" onclick="event.stopPropagation(); openPanel(@order.Id); return false;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                View
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Order Detail Panels -->
@foreach (var order in Model.AllOrders)
{
    var pType = !string.IsNullOrEmpty(order.DiscountType)
        ? order.DiscountType
        : (order.DiscountRequest == "PWD" || order.DiscountRequest == "Senior")
            ? order.DiscountRequest
            : "Regular";
    var pVerified = !string.IsNullOrEmpty(order.DiscountType);
    var isTakeOut = order.Type == "take-out";

    <div id="panel-overlay-@order.Id" class="panel-overlay" style="display:none;" onclick="closePanel(@order.Id)"></div>

    <div id="panel-@order.Id" class="order-details-panel" style="display:none;" role="dialog" aria-label="Order @order.OrderNumber details">
        <div class="panel-header">
            <div class="panel-header-content">
                <h2>Order #@order.OrderNumber</h2>
                <p class="panel-subtitle" id="panel-status-@order.Id">
                    @order.Status.ToUpper() • @order.ElapsedTime elapsed
                </p>
            </div>
            <a href="#" class="btn-close" aria-label="Close" onclick="closePanel(@order.Id); return false;">×</a>
        </div>

        <div class="panel-content">
            <div class="panel-section">
                <h3>Order Information</h3>
                <div class="info-grid">
                    <div class="info-item">
                        <label>Customer</label>
                        <p>@order.CustomerName</p>
                    </div>
                    <div class="info-item">
                        <label>Customer Type</label>
                        <p>
                            <span class="customer-badge ct-@pType.ToLower()">
                                @(pType == "Regular" ? "👤" : "🪪") @pType
                            </span>
                            @if (pType != "Regular")
                            {
                                <small class="info-sub">
                                    @(pVerified ? "ID verified" : "ID not yet verified")
                                </small>
                            }
                        </p>
                    </div>
                    <div class="info-item">
                        <label>Order Type</label>
                        <div class="info-badge @order.Type">@order.Type</div>
                    </div>
                    @if (!string.IsNullOrEmpty(order.Table))
                    {
                        <div class="info-item">
                            <label>Table</label>
                            <p>@order.Table</p>
                        </div>
                    }
                    <div class="info-item">
                        <label>Status</label>
                        <div class="info-badge @Slug(order.Status)" id="panel-status-badge-@order.Id">@order.Status</div>
                    </div>
                    <div class="info-item">
                        <label>Time</label>
                        <p id="panel-elapsed-@order.Id">@order.ElapsedTime</p>
                    </div>
                </div>
            </div>

            <div class="panel-section">
                <h3>Items Ordered</h3>
                <div class="items-list">
                    @foreach (var item in order.Items)
                    {
                        <div class="item-row">
                            <div class="item-details">
                                <p class="item-main">@item.Quantity × @item.Name</p>
                                @if (!string.IsNullOrEmpty(item.Customization))
                                {
                                    <p class="item-meta">→ @item.Customization</p>
                                }
                                @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                                {
                                    <p class="item-meta"><i class="fa-solid fa-note-sticky"></i> @item.SpecialInstructions</p>
                                }
                            </div>
                            <p class="item-price">₱@item.Price.ToString("0.00")</p>
                        </div>
                    }
                </div>
            </div>

            @* ── DISCOUNT SECTION ──
               Lives outside panel-actions so the JS rebuild never wipes what the cashier is typing.
               Take-out orders waiting for payment ALWAYS get the Regular / Senior / PWD chooser.
               Dine-in keeps its original behaviour. *@
            @if ((isTakeOut && order.Status == "Waiting Payment")
                || order.DiscountRequest == "PWD" || order.DiscountRequest == "Senior"
                || !string.IsNullOrEmpty(order.DiscountType))
            {
                <div class="panel-section" id="discount-section-@order.Id">
                    <h3>@(isTakeOut && order.Status == "Waiting Payment" ? "Customer Type & Discount" : "Discount")</h3>

                    @if (string.IsNullOrEmpty(order.DiscountType) && order.Status == "Waiting Payment" && isTakeOut)
                    {
                        @* ═══ TAKE-OUT: choose Regular / Senior / PWD ═══ *@
                        var tkInit = (order.DiscountRequest == "PWD" || order.DiscountRequest == "Senior")
                            ? order.DiscountRequest
                            : "Regular";

                        <p class="discount-intro">
                            Select the customer type for this take-out order.
                            @if (tkInit != "Regular")
                            {
                                <text>Customer requested <strong>@tkInit</strong>. Check their ID before applying.</text>
                            }
                        </p>

                        <form method="post" asp-page-handler="ApplyDiscount" class="discount-form" id="tk-form-@order.Id">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <input type="hidden" name="selectedTab" value="@Model.SelectedTab" />
                            <input type="hidden" name="selectedFilter" value="@Model.SelectedFilter" />
                            <input type="hidden" name="discountType" id="tk-dtype-@order.Id" value="@tkInit" />

                            <div class="tk-seg" role="radiogroup" aria-label="Customer type">
                                <button type="button" class="tk-opt @(tkInit == "Regular" ? "active" : "")" data-type="Regular"
                                        role="radio" aria-checked="@(tkInit == "Regular" ? "true" : "false")"
                                        onclick="tkSelectType(@order.Id, 'Regular')">
                                    <span>👤 Regular</span><small>No discount</small>
                                </button>
                                <button type="button" class="tk-opt @(tkInit == "Senior" ? "active" : "")" data-type="Senior"
                                        role="radio" aria-checked="@(tkInit == "Senior" ? "true" : "false")"
                                        onclick="tkSelectType(@order.Id, 'Senior')">
                                    <span>🪪 Senior</span><small>20% off</small>
                                </button>
                                <button type="button" class="tk-opt @(tkInit == "PWD" ? "active" : "")" data-type="PWD"
                                        role="radio" aria-checked="@(tkInit == "PWD" ? "true" : "false")"
                                        onclick="tkSelectType(@order.Id, 'PWD')">
                                    <span>🪪 PWD</span><small>20% off</small>
                                </button>
                            </div>

                            <div class="tk-regular-note" id="tk-reg-@order.Id" @(tkInit == "Regular" ? "" : "hidden")>
                                <p>Regular customer. No discount applies, so you can take payment right away.</p>
                                <button type="button" class="action-btn btn-paid" onclick="openPayModal(@order.Id)">
                                    <i class="fa-solid fa-peso-sign"></i> Take payment
                                </button>
                            </div>

                            <div class="tk-fields" id="tk-fields-@order.Id" @(tkInit == "Regular" ? "hidden" : "")>
                                <label class="field">
                                    <span>ID number</span>
                                    <input type="text" name="idNumber" placeholder="Enter ID number" required
                                           disabled="@(tkInit == "Regular")" />
                                </label>
                                <label class="field">
                                    <span>Name on ID</span>
                                    <input type="text" name="idName" placeholder="Enter name as shown on ID" required
                                           disabled="@(tkInit == "Regular")" />
                                </label>
                                <button type="submit" class="action-btn btn-accept" id="tk-submit-@order.Id">
                                    Verify &amp; Apply 20% Discount
                                </button>
                            </div>
                        </form>
                    }
                    else if (string.IsNullOrEmpty(order.DiscountType) && order.Status == "Waiting Payment")
                    {
                        @* ═══ DINE-IN: original behaviour (unchanged) ═══ *@
                        <p class="discount-intro">
                            Customer requested <strong>@order.DiscountRequest</strong>. Check their ID, then apply the discount before taking payment.
                        </p>
                        <form method="post" asp-page-handler="ApplyDiscount" class="discount-form">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <input type="hidden" name="selectedTab" value="@Model.SelectedTab" />
                            <input type="hidden" name="selectedFilter" value="@Model.SelectedFilter" />
                            <label class="field">
                                <span>Discount type</span>
                                <select name="discountType" required>
                                    <option value="PWD" selected="@(order.DiscountRequest == "PWD")">PWD</option>
                                    <option value="Senior" selected="@(order.DiscountRequest == "Senior")">Senior Citizen</option>
                                </select>
                            </label>
                            <label class="field">
                                <span>ID number</span>
                                <input type="text" name="idNumber" placeholder="Enter ID number" required />
                            </label>
                            <label class="field">
                                <span>Name on ID</span>
                                <input type="text" name="idName" placeholder="Enter name as shown on ID" required />
                            </label>
                            <button type="submit" class="action-btn btn-accept">Verify &amp; Apply 20% Discount</button>
                        </form>
                    }
                    else if (!string.IsNullOrEmpty(order.DiscountType))
                    {
                        <div class="info-grid">
                            <div class="info-item"><label>Type</label><p>@order.DiscountType</p></div>
                            <div class="info-item"><label>Name on ID</label><p>@order.DiscountIdName</p></div>
                            <div class="info-item"><label>ID Number</label><p>@order.DiscountIdNumber</p></div>
                            <div class="info-item"><label>Verified by</label><p>@order.DiscountVerifiedBy</p></div>
                        </div>
                        @if (order.Status == "Waiting Payment")
                        {
                            <form method="post" asp-page-handler="RemoveDiscount" class="discount-remove"
                                  data-confirm="Remove the @order.DiscountType discount from order #@order.OrderNumber?">
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <input type="hidden" name="selectedTab" value="@Model.SelectedTab" />
                                <input type="hidden" name="selectedFilter" value="@Model.SelectedFilter" />
                                <button type="submit" class="action-btn btn-danger">Remove Discount</button>
                            </form>
                        }
                    }
                    else
                    {
                        <p class="discount-intro">
                            Customer requested <strong>@order.DiscountRequest</strong>, but no discount was applied before payment.
                        </p>
                    }
                </div>
            }

            <div class="panel-section">
                <h3>Summary</h3>
                <div class="summary-table">
                    @if (!string.IsNullOrEmpty(order.DiscountType))
                    {
                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>₱@((order.Total + order.DiscountAmount).ToString("0.00"))</span>
                        </div>
                        <div class="summary-row discount-row">
                            <span>@order.DiscountType Discount (VAT-exempt + 20%)</span>
                            <span>−₱@order.DiscountAmount.ToString("0.00")</span>
                        </div>
                    }
                    else
                    {
                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>₱@order.Total.ToString("0.00")</span>
                        </div>
                    }
                    <div class="summary-row total">
                        <span>Total Amount</span>
                        <span>₱@order.Total.ToString("0.00")</span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(order.SpecialInstructions))
            {
                <div class="panel-section">
                    <h3>Special Instructions</h3>
                    <div class="special-instructions">@order.SpecialInstructions</div>
                </div>
            }
        </div>

        <div class="panel-actions" id="panel-actions-@order.Id">
            @if (order.Status == "printing")
            {
                <div class="print-lock"><i class="fa-solid fa-print"></i> Printing receipt… Accept Order unlocks when it finishes.</div>
            }

            @if (order.Status == "Waiting Payment")
            {
                <button type="button" class="action-btn btn-paid" onclick="openPayModal(@order.Id)">
                    <i class="fa-solid fa-peso-sign"></i> Mark as Paid
                </button>
                <form method="post" asp-page-handler="UpdateStatus"
                      data-confirm="Cancel order #@order.OrderNumber? This cannot be undone.">
                    <input type="hidden" name="orderId" value="@order.Id" />
                    <input type="hidden" name="newStatus" value="cancelled" />
                    <input type="hidden" name="selectedTab" value="@Model.SelectedTab" />
                    <input type="hidden" name="selectedFilter" value="@Model.SelectedFilter" />
                    <button type="submit" class="action-btn btn-danger">Cancel Order</button>
                </form>
            }

            @if (order.Status == "pending")
            {
                <form method="post" asp-page-handler="UpdateStatus">
                    <input type="hidden" name="orderId" value="@order.Id" />
                    <input type="hidden" name="newStatus" value="preparing" />
                    <input type="hidden" name="selectedTab" value="@Model.SelectedTab" />
                    <input type="hidden" name="selectedFilter" value="@Model.SelectedFilter" />
                    <button type="submit" class="action-btn btn-accept">Accept Order</button>
                </form>
            }

            @if (order.Status == "preparing")
            {
                <form method="post" asp-page-handler="UpdateStatus">
                    <input type="hidden" name="orderId" value="@order.Id" />
                    <input type="hidden" name="newStatus" value="ready" />
                    <input type="hidden" name="selectedTab" value="@Model.SelectedTab" />
                    <input type="hidden" name="selectedFilter" value="@Model.SelectedFilter" />
                    <button type="submit" class="action-btn btn-ready">Mark Ready</button>
                </form>
            }

            @if (order.Status == "ready")
            {
                <form method="post" asp-page-handler="UpdateStatus">
                    <input type="hidden" name="orderId" value="@order.Id" />
                    <input type="hidden" name="newStatus" value="paid" />
                    <input type="hidden" name="selectedTab" value="@Model.SelectedTab" />
                    <input type="hidden" name="selectedFilter" value="@Model.SelectedFilter" />
                    <button type="submit" class="action-btn btn-paid">Mark Served</button>
                </form>
            }

            @if (order.Status != "printing")
            {
                <form method="post" asp-page-handler="PrintReceipt">
                    <input type="hidden" name="orderId" value="@order.Id" />
                    <button type="submit" class="action-btn btn-print">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <polyline points="6 9 6 2 18 2 18 9"></polyline>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                            <rect x="6" y="14" width="12" height="8"></rect>
                        </svg>
                        Print Receipt
                    </button>
                </form>
            }
            <a href="#" class="action-btn btn-ghost" onclick="closePanel(@order.Id); return false;">Close</a>
        </div>
    </div>
}

<!-- ══════════════ PAYMENT MODAL ══════════════ -->
<div id="pay-modal" class="pay-modal" hidden>
    <div class="pay-backdrop" onclick="closePayModal()"></div>

    <form id="pay-form" class="pay-dialog" method="post" asp-page-handler="UpdateStatus"
          role="dialog" aria-modal="true" aria-labelledby="pay-title"
          autocomplete="off" onsubmit="return submitPayment(event)">
        <input type="hidden" name="orderId" id="pay-f-order" />
        <input type="hidden" name="newStatus" value="pending" />
        <input type="hidden" name="selectedTab" value="@Model.SelectedTab" />
        <input type="hidden" name="selectedFilter" value="@Model.SelectedFilter" />
        <input type="hidden" name="amountTendered" id="pay-f-tendered" />
        <input type="hidden" name="changeAmount" id="pay-f-change" />

        <div class="pay-head">
            <div>
                <h2 id="pay-title">Take payment</h2>
                <p class="pay-meta" id="pay-meta"></p>
            </div>
            <button type="button" class="pay-x" onclick="closePayModal()" aria-label="Close">×</button>
        </div>

        <div class="pay-body">
            <!-- Take-out only: customer type chooser -->
            <div class="tk-type" id="pay-type" hidden>
                <span class="tk-type-label">Customer type · Take-Out</span>
                <div class="tk-seg" role="radiogroup" aria-label="Customer type">
                    <button type="button" class="tk-opt" data-type="Regular" role="radio" aria-checked="false" onclick="setPayType('Regular')">
                        <span>👤 Regular</span><small>No discount</small>
                    </button>
                    <button type="button" class="tk-opt" data-type="Senior" role="radio" aria-checked="false" onclick="setPayType('Senior')">
                        <span>🪪 Senior</span><small>20% off</small>
                    </button>
                    <button type="button" class="tk-opt" data-type="PWD" role="radio" aria-checked="false" onclick="setPayType('PWD')">
                        <span>🪪 PWD</span><small>20% off</small>
                    </button>
                </div>
                <p class="tk-lock-hint" id="pay-type-hint" hidden></p>
            </div>

            <div class="pay-warn" id="pay-warn" hidden>
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>
                    <strong id="pay-warn-text"></strong>
                    <button type="button" class="pay-link" onclick="verifyDiscountFirst()">Verify ID first</button>
                </div>
            </div>

            <div class="pay-due">
                <span class="pay-due-label">Amount due</span>
                <span class="pay-due-value" id="pay-due">₱0.00</span>
                <span class="pay-due-note" id="pay-due-note" hidden></span>
            </div>

            <label class="pay-field" for="pay-input">
                <span>Cash received</span>
                <div class="pay-input-wrap">
                    <span class="pay-peso">₱</span>
                    <input id="pay-input" type="text" inputmode="decimal" placeholder="0.00"
                           oninput="onPayInput()" aria-describedby="pay-result" />
                </div>
            </label>

            <div class="pay-chips" id="pay-chips" aria-label="Quick amounts"></div>

            <div class="pay-result" id="pay-result" data-state="idle" aria-live="polite">
                <span class="pay-result-label" id="pay-result-label">Change</span>
                <span class="pay-result-value" id="pay-result-value">—</span>
                <span class="pay-result-hint" id="pay-result-hint">Enter the amount the customer handed over.</span>
            </div>
        </div>

        <div class="pay-foot">
            <button type="button" class="action-btn btn-ghost-border" onclick="closePayModal()">Back</button>
            <button type="submit" class="action-btn btn-paid" id="pay-confirm" disabled>Confirm payment</button>
        </div>
    </form>
</div>

