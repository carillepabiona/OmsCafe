<!-- Receipt printer animation dock -->
<div id="receipt-dock" aria-live="polite"></div>

@{
    // Data the receipt animation needs (active orders only). Keyed by order id.
    var receiptData = Model.AllOrders
        .Where(o => !OmsCafe.Pages.Cashier.OrdersModel.IsCompleted(o.Status) && o.Status != "cancelled")
        .ToDictionary(o => o.Id, o => new
        {
            orderNumber = o.OrderNumber,
            type = o.Type,
            table = o.Table,
            total = o.Total,
            discountType = o.DiscountType,
            discountAmount = o.DiscountAmount,
            items = o.Items.Select(i => new { qty = i.Quantity, name = i.Name, price = i.Price })
        });

    // Data the payment modal + discount overview need. Keyed by order id.
    var payData = Model.AllOrders.ToDictionary(o => o.Id, o => new
    {
        orderNumber = o.OrderNumber,
        customer = o.CustomerName,
        type = o.Type,
        table = o.Table,
        itemCount = o.ItemCount,
        total = o.Total,
        discountType = o.DiscountType,
        discountAmount = o.DiscountAmount,
        discountRequest = o.DiscountRequest
    });

    // Orders already in "printing" when the page loads (just paid / mid-print refresh)
    var printingIds = Model.AllOrders.Where(o => o.Status == "printing").Select(o => o.Id);
}

<script>
    // Move modals out of the layout wrapper so nothing can clip or cover them
    document.querySelectorAll('.panel-overlay, .order-details-panel, #pay-modal, #noshift-modal')
    .forEach(el => document.body.appendChild(el));
    // ── HELPERS ────────────────────────────────────────────────────────────────
    const byId  = id => document.getElementById(id);
    const slug  = s => String(s ?? '').trim().toLowerCase().replace(/\s+/g, '-');
    const sleep = ms => new Promise(r => setTimeout(r, ms));
    const esc   = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const peso  = v => '₱' + Number(v || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    // ── PANEL ──────────────────────────────────────────────────────────────────
    function openPanel(orderId) {
        const panel   = byId('panel-' + orderId);
        const overlay = byId('panel-overlay-' + orderId);
        if (!panel || !overlay) { location.reload(); return; }
        panel.style.display   = 'flex';
        overlay.style.display = 'block';
        document.body.style.overflow = 'hidden';
    }
    function closePanel(orderId) {
        const panel   = byId('panel-' + orderId);
        const overlay = byId('panel-overlay-' + orderId);
        if (panel)   panel.style.display = 'none';
        if (overlay) overlay.style.display = 'none';
        syncScrollLock();
    }
    function openPanelId() {
        const el = document.querySelector('.order-details-panel[style*="flex"]');
        return el ? +el.id.replace('panel-', '') : null;
    }
    function syncScrollLock() {
        const anyOpen = !!openPanelId() || !byId('pay-modal').hidden || !byId('noshift-modal').hidden;
        document.body.style.overflow = anyOpen ? 'hidden' : '';
    }

    // ── TAKE-OUT: CUSTOMER TYPE CHOOSER IN THE ORDER PANEL ────────────────────
    // Regular -> no discount, go straight to payment.
    // Senior / PWD -> show ID fields and the "Verify & Apply" button.
    function tkSelectType(id, type) {
        const form = byId('tk-form-' + id);
        if (!form) return;

        const dtype = byId('tk-dtype-' + id);
        if (dtype) dtype.value = type;

        form.querySelectorAll('.tk-opt').forEach(b => {
            const on = b.dataset.type === type;
            b.classList.toggle('active', on);
            b.setAttribute('aria-checked', on ? 'true' : 'false');
        });

        const isRegular = type === 'Regular';
        const fields = byId('tk-fields-' + id);
        const note   = byId('tk-reg-' + id);
        if (fields) {
            fields.hidden = isRegular;
            // disabled inputs are skipped by validation + submit, so Regular never gets blocked
            fields.querySelectorAll('input').forEach(i => { i.disabled = isRegular; });
        }
        if (note) note.hidden = !isRegular;

        const btn = byId('tk-submit-' + id);
        if (btn) btn.textContent = `Verify & Apply 20% ${type === 'Senior' ? 'Senior' : 'PWD'} Discount`;
    }

    // ── TAKE-OUT: QUICK ACTIONS FROM THE ORDER CARD / DISCOUNT LIST ───────────
    // Open the order panel on the right customer type and scroll to the ID fields.
    function tkVerify(id, type) {
        openPanel(id);
        if (type === 'Senior' || type === 'PWD') tkSelectType(id, type);
        setTimeout(() => byId(`discount-section-${id}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' }), 60);
    }

    // Card row: Regular -> straight to payment, Senior/PWD -> verify ID first
    function tkQuick(id, type) {
        const row = byId('tk-quick-' + id);
        if (row) row.querySelectorAll('.tk-quick-btn').forEach(b => b.classList.toggle('active', b.dataset.type === type));
        if (type === 'Regular') openPayModal(id);
        else tkVerify(id, type);
    }

    // ── DISCOUNT OVERVIEW SECTION ─────────────────────────────────────────────
    let customerFilter = 'all';

    // Click a count chip to show only that customer type in the order grid
    function applyCustomerFilter(type) {
        customerFilter = type;
        document.querySelectorAll('.ds-chip').forEach(c => c.classList.toggle('active', c.dataset.ctf === type));
        document.querySelectorAll('#orders-grid .order-card').forEach(card => {
            const hide = type !== 'all' && card.dataset.customerType !== type;
            card.classList.toggle('ct-hidden', hide);
        });
        checkEmptyState();
    }

    // "Verify ID" in the waiting list: take-out gets the chooser, dine-in keeps its own form
    function verifyFromList(id) {
        const d = PAY_DATA[id];
        if (d && d.type === 'take-out') {
            tkVerify(id, d.discountRequest);
        } else {
            openPanel(id);
            setTimeout(() => byId(`discount-section-${id}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' }), 60);
        }
    }

    // Recompute counts from live statuses + the discount data loaded with the page
    function refreshDiscountSection(orders) {
        if (!byId('discount-overview')) return;

        const custOf = d => d.discountType
            ? d.discountType
            : (d.discountRequest === 'PWD' || d.discountRequest === 'Senior') ? d.discountRequest : 'Regular';

        const counts = { Regular: 0, Senior: 0, PWD: 0 };
        let active = 0, given = 0;
        const pending = [];

        orders.forEach(o => {
            const d = PAY_DATA[o.id];
            if (!d || o.status === 'cancelled') return;

            if (d.discountType) given += Number(d.discountAmount || 0);

            if (isCompleted(o.status)) return;
            active++;
            const ct = custOf(d);
            if (counts[ct] !== undefined) counts[ct]++;

            if (o.status === 'Waiting Payment' && !d.discountType
                && (d.discountRequest === 'PWD' || d.discountRequest === 'Senior')) {
                pending.push({ id: o.id, d });
            }
        });

        const set = (id, v) => { const el = byId(id); if (el) el.textContent = v; };
        set('ds-all', active);
        set('ds-regular', counts.Regular);
        set('ds-senior', counts.Senior);
        set('ds-pwd', counts.PWD);
        set('ds-given', peso(given));
        set('ds-pending-count', pending.length);

        const box  = byId('ds-pending');
        const list = byId('ds-pending-list');
        if (box)  box.hidden = pending.length === 0;
        if (list) {
            list.innerHTML = pending.map(p => `
                <div class="ds-item">
                    <span><strong>#${esc(p.d.orderNumber)}</strong> · ${p.d.type === 'take-out' ? 'Take-Out' : 'Dine-In'} · requested ${esc(p.d.discountRequest)}</span>
                    <button type="button" class="ds-item-btn" onclick="verifyFromList(${p.id})">Verify ID</button>
                </div>`).join('');
        }
    }

    // ── SEARCH ────────────────────────────────────────────────────────────────
    // Search reloads the page, so remember to put the cursor back afterwards.
    let searchTimeout;
    function debouncedSearch(input) {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            try { sessionStorage.setItem('orders-refocus', '1'); } catch (e) {}
            input.form.submit();
        }, 500);
    }
    byId('filterForm').addEventListener('submit', () => {
        try { sessionStorage.setItem('orders-refocus', '1'); } catch (e) {}
    });
    (function restoreSearchFocus() {
        try {
            if (sessionStorage.getItem('orders-refocus')) {
                sessionStorage.removeItem('orders-refocus');
                const i = byId('search-input');
                i.focus();
                const n = i.value.length;
                i.setSelectionRange(n, n);
            }
        } catch (e) {}
    })();

    // ── STATE ─────────────────────────────────────────────────────────────────
    const ACTIVE_TAB    = '@Model.SelectedTab';
    const ACTIVE_FILTER = '@Model.SelectedFilter';
    const HAS_SEARCH    = @(string.IsNullOrWhiteSpace(Model.SearchQuery) ? "false" : "true");

    const isCompleted = s => s === 'paid' || s === 'served';
    const IN_PROGRESS = new Set(['pending', 'preparing', 'ready']);

    // Mirrors OrdersModel.MatchesTab on the server
    function inTab(order, tab) {
        if (order.status === 'cancelled') return false;
        switch (tab) {
            case 'completed': return isCompleted(order.status);
            case 'dine-in':   return !isCompleted(order.status) && order.type === 'dine-in';
            case 'take-out':  return !isCompleted(order.status) && order.type === 'take-out';
            default:          return !isCompleted(order.status);   // 'all' = dine-in + take-out
        }
    }

    function belongsHere(order) {
        if (!inTab(order, ACTIVE_TAB)) return false;
        if (ACTIVE_TAB === 'completed' || ACTIVE_FILTER === 'all') return true;
        return order.status === ACTIVE_FILTER;
    }

    const lastStatus = new Map();   // orderId -> last status we rendered

    // ── SILENT SYNC ───────────────────────────────────────────────────────────
    async function syncOrderStatuses() {
        try {
            const res = await fetch('/api/kds/orders-all');
            if (!res.ok) return;
            const orders = await res.json();

            let inProgressCount = 0, readyCount = 0, needsReload = false;
            const tabCounts = { 'all': 0, 'dine-in': 0, 'take-out': 0, 'completed': 0 };

            orders.forEach(order => {
                const newStatus = order.status;
                const changed   = lastStatus.get(order.id) !== newStatus;
                lastStatus.set(order.id, newStatus);

                Object.keys(tabCounts).forEach(t => { if (inTab(order, t)) tabCounts[t]++; });
                if (IN_PROGRESS.has(newStatus)) inProgressCount++;
                if (newStatus === 'ready') readyCount++;

                const card = byId(`order-card-${order.id}`);

                // receipt printing
                if (newStatus === 'printing') queueReceipt(order.id);
                if (newStatus !== 'printing') byId(`print-ind-${order.id}`)?.remove();

                // the quick "Mark as Paid" button and take-out type row only make sense while waiting for payment
                if (newStatus !== 'Waiting Payment') {
                    byId(`quick-pay-${order.id}`)?.remove();
                    byId(`tk-quick-${order.id}`)?.remove();
                }

                // 1. card status badge + accent colour
                if (card) {
                    const prev = card.dataset.status;
                    if (prev !== newStatus) {
                        card.classList.remove(`order-${slug(prev)}`);
                        card.classList.add(`order-${slug(newStatus)}`);
                        card.dataset.status = newStatus;

                        const badge = byId(`status-badge-${order.id}`);
                        if (badge) {
                            badge.textContent = newStatus;
                            badge.className   = `order-status-badge ${slug(newStatus)}`;
                        }

                        card.classList.remove('order-card-updated');
                        void card.offsetWidth;
                        card.classList.add('order-card-updated');
                    }
                    const elapsedEl = byId(`elapsed-${order.id}`);
                    if (elapsedEl && order.elapsedTime) elapsedEl.textContent = order.elapsedTime;
                }

                // 2. detail panel (subtitle, badge, time)
                const panelSub = byId(`panel-status-${order.id}`);
                if (panelSub) panelSub.textContent = `${newStatus.toUpperCase()} • ${order.elapsedTime || ''} elapsed`;
                const panelBadge = byId(`panel-status-badge-${order.id}`);
                if (panelBadge) {
                    panelBadge.textContent = newStatus;
                    panelBadge.className   = `info-badge ${slug(newStatus)}`;
                }
                const panelElapsed = byId(`panel-elapsed-${order.id}`);
                if (panelElapsed && order.elapsedTime) panelElapsed.textContent = order.elapsedTime;

                // 3. rebuild action buttons ONLY when the status changed
                if (changed) {
                    const panelActions = byId(`panel-actions-${order.id}`);
                    if (panelActions) panelActions.innerHTML = buildActionButtons(order);
                }

                // 4. does this order still belong on the current tab / filter?
                if (card) {
                    if (!belongsHere(order) && !card.classList.contains('order-card-exit')) {
                        card.classList.add('order-card-exit');
                        setTimeout(() => { card.remove(); checkEmptyState(); }, 360);
                    }
                } else if (belongsHere(order)) {
                    needsReload = true;
                }
            });

            const set = (id, v) => { const el = byId(id); if (el) el.textContent = v; };
            set('hdr-total',      orders.filter(o => o.status !== 'cancelled').length);
            set('hdr-inprogress', inProgressCount);
            set('hdr-ready',      readyCount);
            Object.entries(tabCounts).forEach(([tab, n]) => set(`tab-badge-${tab}`, n));

            // discount overview (counts, discount given, waiting-for-ID list)
            refreshDiscountSection(orders);

            // New order for this tab -> reload quietly, but never while someone is
            // in a panel, taking payment, or a receipt is printing.
            const busy = !!openPanelId() || !byId('pay-modal').hidden || !byId('noshift-modal').hidden || printBusy;
            if (needsReload && !HAS_SEARCH && !busy) location.reload();

        } catch (e) {
            console.error('Sync error:', e);
        }
    }

    function checkEmptyState() {
        const grid  = byId('orders-grid');
        const cards = grid ? grid.querySelectorAll('.order-card:not(.order-card-exit):not(.ct-hidden)') : [];
        const empty = byId('empty-state');
        if (empty) empty.style.display = cards.length ? 'none' : '';
    }

    // ── BUILD ACTION BUTTONS (for panel re-render) ────────────────────────────
    function buildActionButtons(order) {
        let html  = '';
        const token = document.querySelector('input[name=__RequestVerificationToken]')?.value || '';

        const hiddens = `
            <input type="hidden" name="__RequestVerificationToken" value="${token}" />
            <input type="hidden" name="selectedTab"    value="${ACTIVE_TAB}" />
            <input type="hidden" name="selectedFilter" value="${ACTIVE_FILTER}" />
            <input type="hidden" name="orderId"        value="${order.id}" />`;

        if (order.status === 'printing') {
            html += `<div class="print-lock"><i class="fa-solid fa-print"></i> Printing receipt… Accept Order unlocks when it finishes.</div>`;
        }
        if (order.status === 'Waiting Payment') {
            html += `
            <button type="button" class="action-btn btn-paid" onclick="openPayModal(${order.id})"><i class="fa-solid fa-peso-sign"></i> Mark as Paid</button>
            <form method="post" action="?handler=UpdateStatus" data-confirm="Cancel this order? This cannot be undone.">
                ${hiddens}
                <input type="hidden" name="newStatus" value="cancelled" />
                <button type="submit" class="action-btn btn-danger">Cancel Order</button>
            </form>`;
        }
        if (order.status === 'pending') {
            html += `
            <form method="post" action="?handler=UpdateStatus">
                ${hiddens}
                <input type="hidden" name="newStatus" value="preparing" />
                <button type="submit" class="action-btn btn-accept">Accept Order</button>
            </form>`;
        }
        if (order.status === 'preparing') {
            html += `
            <form method="post" action="?handler=UpdateStatus">
                ${hiddens}
                <input type="hidden" name="newStatus" value="ready" />
                <button type="submit" class="action-btn btn-ready">Mark Ready</button>
            </form>`;
        }
        if (order.status === 'ready') {
            html += `
            <form method="post" action="?handler=UpdateStatus">
                ${hiddens}
                <input type="hidden" name="newStatus" value="paid" />
                <button type="submit" class="action-btn btn-paid">Mark Served</button>
            </form>`;
        }

        if (order.status !== 'printing') {
            html += `
            <form method="post" action="?handler=PrintReceipt">
                <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                <input type="hidden" name="orderId" value="${order.id}" />
                <button type="submit" class="action-btn btn-print"><i class="fa-solid fa-print"></i> Print Receipt</button>
            </form>`;
        }
        html += `<a href="#" class="action-btn btn-ghost" onclick="closePanel(${order.id}); return false;">Close</a>`;

        return html;
    }

    // ── FORM SAFETY: confirm dialogs + no double submits ─────────────────────
    document.addEventListener('submit', e => {
        const f = e.target;
        if (f.id === 'pay-form' || f.id === 'filterForm') return;
        const msg = f.dataset.confirm;
        if (msg && !confirm(msg)) { e.preventDefault(); return; }
        setTimeout(() => f.querySelectorAll('button[type=submit]').forEach(b => b.disabled = true), 0);
    });

    // ══════════════ PAYMENT MODAL ══════════════
    const PAY_DATA = @Json.Serialize(payData);

    const payModal = byId('pay-modal');
    const payInput = byId('pay-input');
    let payOrderId = null, payDueCents = 0, payReturnFocus = null;

    // Take-out customer type state (dine-in never touches these)
    let payIsTakeOut = false;
    let payCustType  = 'Regular';
    let payTypeLocked = false;

    const toCents = v => Math.round((parseFloat(v) || 0) * 100);

    function quickAmounts(dueCents) {
        // Round the bill up to the next 50 / 100 / 500 / 1000, skip duplicates and the exact amount
        const due = dueCents / 100;
        const out = new Set();
        [50, 100, 500, 1000].forEach(d => {
            const v = Math.ceil(due / d) * d;
            if (v * 100 > dueCents) out.add(v);
        });
        return [...out].sort((a, b) => a - b).slice(0, 4);
    }

    // Take-out: Senior / PWD must be verified before payment can be confirmed
    function payBlocked() {
        if (!payIsTakeOut) return false;
        const d = PAY_DATA[payOrderId];
        return payCustType !== 'Regular' && !(d && d.discountType);
    }

    // Warning box. Dine-in keeps the original (non-blocking) warning.
    function refreshPayWarn() {
        const d = PAY_DATA[payOrderId];
        if (!d) return;
        const warn = byId('pay-warn');
        const text = byId('pay-warn-text');

        if (payIsTakeOut) {
            if (payBlocked()) {
                text.textContent = `${payCustType} selected. Verify the customer's ID before taking payment.`;
                warn.hidden = false;
            } else {
                warn.hidden = true;
            }
            return;
        }

        if (!d.discountType && (d.discountRequest === 'PWD' || d.discountRequest === 'Senior')) {
            text.textContent = `Customer requested a ${d.discountRequest} discount and the ID isn't verified yet.`;
            warn.hidden = false;
        } else {
            warn.hidden = true;
        }
    }

    function renderPayType() {
        byId('pay-type').querySelectorAll('.tk-opt').forEach(b => {
            const on = b.dataset.type === payCustType;
            b.classList.toggle('active', on);
            b.setAttribute('aria-checked', on ? 'true' : 'false');
            b.disabled = payTypeLocked;
        });
        const hint = byId('pay-type-hint');
        if (payTypeLocked) {
            hint.textContent = `${payCustType} discount already verified. Remove it in the order panel to change the customer type.`;
            hint.hidden = false;
        } else {
            hint.hidden = true;
        }
    }

    function setPayType(type) {
        if (payTypeLocked) return;
        payCustType = type;
        renderPayType();
        refreshPayWarn();
        onPayInput(true);   // re-evaluates the Confirm button
    }

    function openPayModal(id) {
        // No open shift -> show the popup instead of the payment dialog
        if (!HAS_OPEN_SHIFT) { showNoShiftModal(); return; }

        const d = PAY_DATA[id];
        if (!d) { location.reload(); return; }

        payOrderId     = id;
        payDueCents    = toCents(d.total);
        payReturnFocus = document.activeElement;

        byId('pay-f-order').value = id;
        byId('pay-title').textContent = `Take payment · #${d.orderNumber}`;
        byId('pay-meta').textContent = [
            d.customer,
            d.type === 'dine-in' ? 'Dine-In' : 'Take-Out',
            d.table ? `Table ${d.table}` : null,
            `${d.itemCount} item${d.itemCount === 1 ? '' : 's'}`
        ].filter(Boolean).join(' · ');

        byId('pay-due').textContent = peso(d.total);

        // discount info
        const note = byId('pay-due-note');
        if (d.discountType) {
            note.textContent = `${d.discountType} discount applied (−${peso(d.discountAmount)})`;
            note.hidden = false;
        } else {
            note.hidden = true;
        }

        // take-out: customer type chooser (dine-in: hidden, behaviour unchanged)
        payIsTakeOut = d.type === 'take-out';
        byId('pay-type').hidden = !payIsTakeOut;
        if (payIsTakeOut) {
            payTypeLocked = !!d.discountType;
            payCustType   = d.discountType
                || ((d.discountRequest === 'PWD' || d.discountRequest === 'Senior') ? d.discountRequest : 'Regular');
            renderPayType();
        } else {
            payTypeLocked = false;
            payCustType   = 'Regular';
        }
        refreshPayWarn();

        // quick-amount chips
        const chips = byId('pay-chips');
        chips.innerHTML = '';
        const mk = (label, cents) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'pay-chip';
            b.dataset.cents = cents;
            b.textContent = label;
            b.onclick = () => { payInput.value = (cents / 100).toFixed(2); onPayInput(true); payInput.focus(); };
            chips.appendChild(b);
        };
        mk('Exact', payDueCents);
        quickAmounts(payDueCents).forEach(v => mk(peso(v).replace('.00', ''), v * 100));

        payInput.value = '';
        onPayInput();

        payModal.hidden = false;
        syncScrollLock();
        setTimeout(() => payInput.focus(), 30);
    }

    function closePayModal() {
        payModal.hidden = true;
        payOrderId = null;
        syncScrollLock();
        if (payReturnFocus && payReturnFocus.focus) payReturnFocus.focus();
    }

    function verifyDiscountFirst() {
        const id   = payOrderId;
        const type = payCustType;
        const isTk = payIsTakeOut;
        closePayModal();
        openPanel(id);
        // take-out: make sure the panel chooser matches what the cashier picked in the modal
        if (isTk && (type === 'Senior' || type === 'PWD')) tkSelectType(id, type);
        setTimeout(() => byId(`discount-section-${id}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' }), 60);
    }

    function onPayInput(fromChip) {
        if (!fromChip) {
            // digits and one decimal point, max 2 decimals
            payInput.value = payInput.value.replace(/[^\d.]/g, '').replace(/^(\d*\.?\d{0,2}).*$/, '$1');
        }
        const has   = payInput.value.trim() !== '';
        const t     = toCents(payInput.value);
        const box   = byId('pay-result');
        const label = byId('pay-result-label');
        const value = byId('pay-result-value');
        const hint  = byId('pay-result-hint');
        let state;

        if (!has) {
            state = 'idle';
            label.textContent = 'Change';
            value.textContent = '—';
            hint.textContent  = 'Enter the amount the customer handed over.';
        } else if (t < payDueCents) {
            state = 'short';
            label.textContent = 'Still needed';
            value.textContent = peso((payDueCents - t) / 100);
            hint.textContent  = 'The amount received is less than the total.';
        } else if (t === payDueCents) {
            state = 'exact';
            label.textContent = 'Change';
            value.textContent = peso(0);
            hint.textContent  = 'Exact amount. No change to give.';
        } else {
            state = 'ok';
            label.textContent = 'Change to give';
            value.textContent = peso((t - payDueCents) / 100);
            hint.textContent  = `Received ${peso(t / 100)}`;
        }
        box.dataset.state = state;
        byId('pay-confirm').disabled = !(has && t >= payDueCents) || payBlocked();

        document.querySelectorAll('#pay-chips .pay-chip').forEach(c =>
            c.classList.toggle('active', has && +c.dataset.cents === t));
    }

    function submitPayment(e) {
        const has = payInput.value.trim() !== '';
        const t   = toCents(payInput.value);
        if (!has || t < payDueCents || payBlocked()) { e.preventDefault(); payInput.focus(); return false; }

        byId('pay-f-tendered').value = (t / 100).toFixed(2);
        byId('pay-f-change').value   = ((t - payDueCents) / 100).toFixed(2);
        setTimeout(() => { byId('pay-confirm').disabled = true; byId('pay-confirm').textContent = 'Saving…'; }, 0);
        return true;
    }

    // Esc closes the no-shift popup first, then the payment modal, then any open panel
    document.addEventListener('keydown', e => {
        if (e.key !== 'Escape') return;
        if (!byId('noshift-modal').hidden) { closeNoShiftModal(); return; }
        if (!payModal.hidden) { closePayModal(); return; }
        const id = openPanelId();
        if (id) closePanel(id);
    });

    // ── CALL STAFF NOTIFICATION SYSTEM ───────────────────────────────────────
    let pendingCallStaff = [];
    let seenCallIds      = new Set();
    let currentCallData  = null;

    async function pollCallStaffNotifications() {
        try {
            const res = await fetch('/api/notifications/call-staff/pending');
            if (!res.ok) return;
            const calls = await res.json();

            calls.forEach(call => {
                if (seenCallIds.has(call.id)) return;
                seenCallIds.add(call.id);
                pendingCallStaff.push(call);
                showStaffToast(call);
                playCallChime();
            });

            const badge = byId('staff-call-badge');
            const count = byId('staff-call-count');
            if (pendingCallStaff.length > 0) {
                badge.style.display = '';
                count.textContent   = pendingCallStaff.length;
            } else {
                badge.style.display = 'none';
            }
        } catch (e) {
            console.error('Call staff poll error:', e);
        }
    }

    function showStaffToast(call) {
        const stack = byId('staff-toast-stack');
        const toast = document.createElement('div');
        toast.className = 'staff-toast';
        toast.id = `staff-toast-${call.id}`;
        toast.innerHTML = `
            <span class="staff-toast-icon"><i class="fa-solid fa-bell"></i></span>
            <div class="staff-toast-body">
                <div class="staff-toast-title">Customer calling — ${esc(call.tableNumber ? 'Table ' + call.tableNumber : call.orderNumber)}</div>
                <div class="staff-toast-sub">${esc(call.message || 'Requesting staff assistance')}</div>
            </div>
            <button type="button" class="staff-toast-ack" onclick="acknowledgeCall(${call.id}, this)">Go</button>`;
        stack.appendChild(toast);
        setTimeout(() => toast.remove(), 30000);
    }

    function showStaffBanner() {
        if (!pendingCallStaff.length) return;
        currentCallData = pendingCallStaff[0];
        byId('staff-notif-title').innerHTML =
            `<i class="fa-solid fa-bell"></i> Customer calling — ${esc(currentCallData.tableNumber ? 'Table ' + currentCallData.tableNumber : currentCallData.orderNumber)}`;
        byId('staff-notif-sub').textContent =
            currentCallData.message || 'Requesting staff for payment';
        byId('staff-notif-banner').style.display = '';
        document.querySelector('.orders-page').style.marginTop = '64px';
    }

    function dismissNotif() {
        byId('staff-notif-banner').style.display = 'none';
        document.querySelector('.orders-page').style.marginTop = '';
    }

    async function acknowledgeCallStaff() {
        if (!currentCallData) return;
        await acknowledgeCall(currentCallData.id, null);
        dismissNotif();
    }

    async function acknowledgeCall(callId, btn) {
        if (btn) btn.disabled = true;
        try {
            await fetch(`/api/notifications/call-staff/${callId}/acknowledge`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
        } catch (e) { /* silent */ }

        pendingCallStaff = pendingCallStaff.filter(c => c.id !== callId);
        byId(`staff-toast-${callId}`)?.remove();

        const badge = byId('staff-call-badge');
        const count = byId('staff-call-count');
        if (pendingCallStaff.length > 0) {
            count.textContent = pendingCallStaff.length;
        } else {
            badge.style.display = 'none';
        }
    }

    function playCallChime() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            [880, 660, 880].forEach((freq, i) => {
                const osc  = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.frequency.value = freq;
                osc.type = 'sine';
                const t = ctx.currentTime + i * 0.2;
                gain.gain.setValueAtTime(0.4, t);
                gain.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
                osc.start(t);
                osc.stop(t + 0.35);
            });
        } catch (e) {}
    }

    // ── AUTOMATIC RECEIPT PRINTING ───────────────────────────────────────────
    // Flow: paid -> status "printing" -> animation -> CompletePrint -> "pending" (Accept Order)
    const RECEIPT_DATA   = @Json.Serialize(receiptData);
    const PRINTING_IDS   = @Json.Serialize(printingIds);
    const RECEIPT_MS     = 3000;   // paper feed duration (keep in sync with rpFeed in orders.css)
    const RECEIPT_DONE   = 900;    // "printed" confirmation before the card leaves

    const printSeen  = new Set();
    const printQueue = [];
    let   printBusy  = false;

    // Cross-tab guard: another terminal showing the same order won't animate it twice
    function claimPrint(id) {
        const k = `rcpt-claim-${id}`;
        try {
            if (Date.now() - (+localStorage.getItem(k) || 0) < 8000) return false;
            localStorage.setItem(k, Date.now());
        } catch (e) {}
        return true;
    }

    function queueReceipt(id) {
        if (printSeen.has(id) || !claimPrint(id)) return;
        printSeen.add(id);
        printQueue.push(id);
        if (!printBusy) runPrintQueue();
    }

    async function runPrintQueue() {
        printBusy = true;
        while (printQueue.length) {
            const id = printQueue.shift();
            const ok = await printReceipt(id);
            if (!ok) {
                printSeen.delete(id);
                try { localStorage.removeItem(`rcpt-claim-${id}`); } catch (e) {}
            }
        }
        printBusy = false;
    }

    function buildReceiptCard(id) {
        const d     = RECEIPT_DATA[id] || {};
        const items = d.items || [];
        const lines = items.slice(0, 3).map(i =>
            `<div class="rp-line"><span>${i.qty}× ${esc(i.name)}</span><span>${peso(i.price)}</span></div>`).join('')
            + (items.length > 3 ? `<div class="rp-line rp-mute"><span>+${items.length - 3} more</span></div>` : '');

        const discountLines = d.discountType
            ? `<div class="rp-line rp-mute"><span>Subtotal</span><span>${peso((d.total || 0) + (d.discountAmount || 0))}</span></div>
               <div class="rp-line"><span>${esc(d.discountType)} discount</span><span>−${peso(d.discountAmount)}</span></div>`
            : '';

        const card = document.createElement('div');
        card.className = 'rp-card';
        card.innerHTML = `
            <div class="rp-head"><span class="rp-dot"></span><span class="rp-label">Printing receipt…</span>
                <span class="rp-order">#${esc(d.orderNumber || id)}</span></div>
            <div class="rp-printer"><div class="rp-slot"></div></div>
            <div class="rp-window"><div class="rp-paper">
                <div class="rp-brand">OMS CAFE</div>
                <div class="rp-line rp-mute"><span>Order #${esc(d.orderNumber || id)}</span></div>
                <div class="rp-line rp-mute"><span>${esc(d.type || '')}${d.table ? ' · ' + esc(d.table) : ''}</span></div>
                <div class="rp-rule"></div>${lines}<div class="rp-rule"></div>
                ${discountLines}
                <div class="rp-line rp-total"><span>TOTAL</span><span>${peso(d.total)}</span></div>
                <div class="rp-thanks">Thank you!</div>
            </div></div>`;
        return card;
    }

    async function completePrint(id) {
        const token = document.querySelector('input[name=__RequestVerificationToken]')?.value || '';
        for (let attempt = 0; attempt < 3; attempt++) {
            try {
                const res = await fetch('?handler=CompletePrint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ orderId: id, __RequestVerificationToken: token })
                });
                if (res.ok) return true;
            } catch (e) {}
            await sleep(600);
        }
        return false;
    }

    async function printReceipt(id) {
        const card = buildReceiptCard(id);
        byId('receipt-dock').appendChild(card);
        requestAnimationFrame(() => card.classList.add('rp-run'));

        await sleep(RECEIPT_MS);
        const ok = await completePrint(id);

        if (ok) {
            card.classList.add('rp-done');
            card.querySelector('.rp-label').textContent = 'Receipt printed ✓';
            syncOrderStatuses();
            await sleep(RECEIPT_DONE);
            try { localStorage.removeItem(`rcpt-claim-${id}`); } catch (e) {}
        }
        card.classList.add('rp-leave');
        await sleep(300);
        card.remove();
        return ok;
    }

    // ══════════════ NO OPEN SHIFT POPUP ══════════════
    const HAS_OPEN_SHIFT = @Json.Serialize(Model.HasOpenShift);
    const NO_SHIFT_FLAG  = @(TempData["NoShift"] != null ? "true" : "false");

    function showNoShiftModal() {
        if (!payModal.hidden) closePayModal();
        byId('noshift-modal').hidden = false;
        syncScrollLock();
    }
    function closeNoShiftModal() {
        byId('noshift-modal').hidden = true;
        syncScrollLock();
    }

    // The server rejected a payment because there was no open shift
    if (NO_SHIFT_FLAG) showNoShiftModal();

    // ── INIT ──────────────────────────────────────────────────────────────────
    PRINTING_IDS.forEach(queueReceipt);
    syncOrderStatuses();
    pollCallStaffNotifications();
    setInterval(syncOrderStatuses,          5000);
    setInterval(pollCallStaffNotifications, 4000);
</script>
