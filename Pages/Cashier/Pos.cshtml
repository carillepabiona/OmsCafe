@page
@model OmsCafe.Pages.Cashier.PosModel
@{
    Layout = null;
    var imageUrlJson = System.Text.Json.JsonSerializer.Serialize(Url.Page("/TakeOut/TakeOutMenu", "Image"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verso Cafe — POS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
            :root {
                --brand: #e47835;
                --brand-dark: #c8631f;
                --brand-soft: #fdeee2;
                --brand-softer: #fff7f0;
                --ink: #1c1917;
                --ink-2: #44403c;
                --muted: #78716c;
                --line: #f0ece8;
                --ok: #15803d;
                --bad: #b91c1c;
                --radius: 16px;
                --shadow: 0 8px 24px -8px rgba(228,120,53,.18),0 2px 6px rgba(28,25,23,.04)
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                -webkit-tap-highlight-color: transparent
            }

            html, body {
                height: 100%
            }

            body {
                font-family: 'Plus Jakarta Sans',system-ui,sans-serif;
                color: var(--ink);
                background: #faf7f4;
                overflow: hidden
            }

            button {
                font-family: inherit;
                cursor: pointer;
                border: none;
                background: none;
                color: inherit
            }

            input {
                font-family: inherit;
                font-size: 14px;
                color: var(--ink)
            }

            .app {
                position: fixed;
                inset: 0;
                display: grid;
                grid-template-columns: 1fr 400px;
                grid-template-rows: 60px 1fr
            }

            .topbar {
                grid-column: 1/-1;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 20px;
                background: #fff;
                border-bottom: 1px solid var(--line)
            }

                .topbar .left {
                    display: flex;
                    align-items: center;
                    gap: 12px
                }

            .logo {
                width: 38px;
                height: 38px;
                border-radius: 11px;
                background: var(--brand);
                color: #fff;
                display: grid;
                place-items: center
            }

            .name {
                font-weight: 800;
                font-size: 17px
            }

            .pill {
                background: var(--brand-soft);
                color: var(--brand-dark);
                padding: 6px 12px;
                border-radius: 999px;
                font-weight: 600;
                font-size: 12px
            }

            .tb-btn {
                padding: 9px 14px;
                border-radius: 11px;
                border: 1px solid var(--line);
                font-weight: 600;
                font-size: 13px;
                color: var(--ink-2)
            }

            a.tb-btn {
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px
            }

            .tb-btn:hover {
                border-color: var(--brand);
                color: var(--brand)
            }

            .catalog {
                display: flex;
                flex-direction: column;
                min-height: 0;
                min-width: 0
            }

            .cat-bar {
                display: flex;
                gap: 8px;
                padding: 12px 16px 0;
                overflow-x: auto;
                flex-shrink: 0
            }

            .cat {
                white-space: nowrap;
                padding: 10px 16px;
                border-radius: 12px;
                background: #fff;
                border: 1px solid var(--line);
                font-weight: 600;
                font-size: 14px;
                color: var(--ink-2)
            }

                .cat.active {
                    background: var(--brand);
                    border-color: var(--brand);
                    color: #fff
                }

            .search {
                display: flex;
                align-items: center;
                gap: 10px;
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 12px;
                padding: 10px 14px;
                margin: 12px 16px 0
            }

                .search input {
                    border: none;
                    outline: none;
                    width: 100%;
                    background: transparent
                }

                .search i {
                    color: var(--muted)
                }

            .grid {
                flex: 1;
                overflow-y: auto;
                padding: 14px 16px 20px;
                display: grid;
                grid-template-columns: repeat(auto-fill,minmax(168px,1fr));
                gap: 12px;
                align-content: start
            }

            .card {
                background: #fff;
                border: 1px solid var(--line);
                border-radius: var(--radius);
                padding: 10px;
                display: flex;
                flex-direction: column;
                text-align: left;
                transition: .15s
            }

                .card:hover {
                    border-color: var(--brand);
                    box-shadow: var(--shadow)
                }

                .card:active {
                    transform: scale(.97)
                }

                .card .thumb {
                    height: 84px;
                    border-radius: 11px;
                    background: linear-gradient(135deg,var(--brand-softer),var(--brand-soft));
                    display: grid;
                    place-items: center;
                    font-size: 32px;
                    color: var(--brand);
                    margin-bottom: 8px;
                    overflow: hidden
                }

                    .card .thumb img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover
                    }

                .card h4 {
                    font-size: 14px;
                    font-weight: 700;
                    line-height: 1.25;
                    flex: 1
                }

                .card .price {
                    font-weight: 800;
                    font-size: 15px;
                    margin-top: 6px;
                    color: var(--brand-dark)
                }

                .card.off {
                    opacity: .5;
                    cursor: not-allowed
                }

                    .card.off .thumb img {
                        filter: grayscale(1)
                    }

            .empty {
                grid-column: 1/-1;
                text-align: center;
                color: var(--muted);
                padding: 50px 0
            }

            .ticket {
                background: #fff;
                border-left: 1px solid var(--line);
                display: flex;
                flex-direction: column;
                min-height: 0;
                overflow: hidden
            }

            .t-sec {
                padding: 14px 16px;
                border-bottom: 1px solid var(--line)
            }

            .t-label {
                font-size: 11px;
                font-weight: 700;
                letter-spacing: .1em;
                text-transform: uppercase;
                color: var(--muted);
                margin-bottom: 8px
            }

            .field {
                width: 100%;
                padding: 10px 12px;
                border: 1.5px solid var(--line);
                border-radius: 11px;
                outline: none;
                background: #faf7f4
            }

                .field:focus {
                    border-color: var(--brand);
                    background: #fff
                }

            .addon-row {
                display: flex;
                gap: 8px;
                margin-top: 8px
            }

            .find {
                padding: 0 16px;
                background: var(--brand);
                color: #fff;
                border-radius: 11px;
                font-weight: 700;
                font-size: 13px
            }

            .recent {
                display: flex;
                gap: 6px;
                flex-wrap: wrap;
                margin-top: 8px
            }

            .rchip {
                padding: 6px 10px;
                border-radius: 999px;
                border: 1.5px solid var(--line);
                font-size: 12px;
                font-weight: 600;
                color: var(--ink-2)
            }

                .rchip:hover {
                    border-color: var(--brand);
                    color: var(--brand)
                }

            .linked {
                margin-top: 8px;
                background: var(--brand-softer);
                border: 1.5px solid var(--brand);
                border-radius: 12px;
                padding: 10px 12px;
                font-size: 13px;
                display: flex;
                justify-content: space-between;
                gap: 10px;
                align-items: flex-start
            }

                .linked b {
                    color: var(--brand-dark)
                }

                .linked small {
                    color: var(--muted);
                    display: block;
                    margin-top: 2px
                }

                .linked button {
                    color: var(--muted);
                    font-size: 16px
                }

            .lines {
                flex: 1;
                overflow-y: auto;
                padding: 0 16px;
                min-height: 80px
            }

            .line {
                padding: 12px 0;
                border-bottom: 1px solid var(--line)
            }

                .line .top {
                    display: flex;
                    justify-content: space-between;
                    gap: 10px;
                    font-weight: 700;
                    font-size: 14px
                }

                .line .mods {
                    color: var(--muted);
                    font-size: 12px;
                    margin-top: 2px
                }

                .line .ctl {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    margin-top: 8px
                }

            .step {
                display: inline-flex;
                align-items: center;
                background: #faf7f4;
                border: 1px solid var(--line);
                border-radius: 10px
            }

                .step button {
                    width: 32px;
                    height: 32px;
                    color: var(--brand);
                    font-size: 12px
                }

                .step span {
                    width: 28px;
                    text-align: center;
                    font-weight: 700;
                    font-size: 14px
                }

            .rm {
                color: var(--muted);
                font-size: 12px
            }

                .rm:hover {
                    color: var(--bad)
                }

            .no-lines {
                text-align: center;
                color: var(--muted);
                padding: 50px 10px;
                font-size: 14px
            }

                .no-lines i {
                    font-size: 40px;
                    color: var(--brand);
                    opacity: .4;
                    display: block;
                    margin-bottom: 10px
                }

            .pay {
                padding: 14px 16px;
                border-top: 1px solid var(--line);
                background: #fafaf9;
                max-height: 68vh;
                overflow-y: auto
            }

            .srow {
                display: flex;
                justify-content: space-between;
                font-size: 14px;
                padding: 3px 0;
                color: var(--ink-2)
            }

                .srow.total {
                    font-weight: 800;
                    font-size: 22px;
                    color: var(--ink)
                }

                .srow.disc {
                    color: var(--ok);
                    font-weight: 600
                }

                .srow.change b {
                    color: var(--ok)
                }

                .srow.change.short b {
                    color: var(--bad)
                }
            /* Discount */
            .disc-box {
                margin-bottom: 10px
            }

            .disc-seg {
                display: grid;
                grid-template-columns: repeat(3,1fr);
                gap: 6px
            }

                .disc-seg button {
                    padding: 9px 0;
                    border-radius: 10px;
                    border: 1.5px solid var(--line);
                    background: #fff;
                    font-weight: 700;
                    font-size: 12px;
                    color: var(--ink-2)
                }

                    .disc-seg button:hover {
                        border-color: var(--brand);
                        color: var(--brand)
                    }

                    .disc-seg button.on {
                        background: var(--brand);
                        border-color: var(--brand);
                        color: #fff
                    }

            .disc-fields {
                display: none;
                margin-top: 8px;
                gap: 6px;
                flex-direction: column
            }

                .disc-fields.show {
                    display: flex
                }

                .disc-fields .field {
                    padding: 8px 10px;
                    font-size: 13px
                }

            .disc-note {
                font-size: 11px;
                color: var(--muted);
                margin-top: 2px
            }

            .quick {
                display: grid;
                grid-template-columns: repeat(5,1fr);
                gap: 6px;
                margin: 8px 0
            }

                .quick button {
                    padding: 9px 0;
                    border-radius: 10px;
                    border: 1.5px solid var(--line);
                    background: #fff;
                    font-weight: 700;
                    font-size: 12px
                }

                    .quick button:hover {
                        border-color: var(--brand);
                        color: var(--brand)
                    }

            .charge {
                width: 100%;
                margin-top: 10px;
                background: var(--brand);
                color: #fff;
                padding: 16px;
                border-radius: 14px;
                font-weight: 800;
                font-size: 16px;
                display: flex;
                justify-content: center;
                gap: 10px;
                align-items: center
            }

                .charge:hover:not(:disabled) {
                    background: var(--brand-dark)
                }

                .charge:disabled {
                    opacity: .45;
                    cursor: not-allowed
                }

            .clear {
                width: 100%;
                margin-top: 6px;
                padding: 8px;
                font-size: 12px;
                font-weight: 600;
                color: var(--muted)
            }

            .err {
                color: var(--bad);
                font-size: 12px;
                font-weight: 600;
                margin-top: 6px;
                min-height: 0
            }

            .ov {
                position: fixed;
                inset: 0;
                background: rgba(28,25,23,.45);
                backdrop-filter: blur(4px);
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0;
                pointer-events: none;
                transition: .2s;
                z-index: 50
            }

                .ov.show {
                    opacity: 1;
                    pointer-events: auto
                }

            .modal {
                background: #fff;
                border-radius: 24px;
                width: min(520px,92%);
                max-height: 90vh;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                box-shadow: 0 30px 60px -20px rgba(28,25,23,.3)
            }

            .m-head {
                position: relative;
                height: 140px;
                background: linear-gradient(135deg,var(--brand-soft),var(--brand-softer));
                display: grid;
                place-items: center;
                font-size: 60px;
                color: var(--brand);
                overflow: hidden
            }

                .m-head img {
                    position: absolute;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    object-fit: cover
                }

            .m-close {
                position: absolute;
                top: 12px;
                right: 12px;
                z-index: 2;
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: rgba(255,255,255,.9)
            }

            .m-body {
                padding: 20px 24px;
                overflow-y: auto;
                flex: 1
            }

                .m-body h3 {
                    font-size: 22px;
                    font-weight: 800
                }

            .m-desc {
                color: var(--muted);
                font-size: 13px;
                margin-top: 4px
            }

            .grp {
                margin-top: 18px
            }

            .seg {
                display: flex;
                background: #faf7f4;
                border-radius: 12px;
                padding: 4px;
                border: 1px solid var(--line)
            }

                .seg button {
                    flex: 1;
                    padding: 10px;
                    border-radius: 9px;
                    font-weight: 600;
                    font-size: 13px;
                    color: var(--ink-2)
                }

                    .seg button.on {
                        background: var(--brand);
                        color: #fff
                    }

            .chips {
                display: flex;
                flex-wrap: wrap;
                gap: 8px
            }

            .chip {
                padding: 9px 14px;
                border-radius: 999px;
                border: 1.5px solid var(--line);
                font-weight: 600;
                font-size: 13px;
                color: var(--ink-2)
            }

                .chip.on {
                    border-color: var(--brand);
                    background: var(--brand-soft);
                    color: var(--brand-dark)
                }

            .m-foot {
                padding: 14px 24px;
                border-top: 1px solid var(--line);
                display: flex;
                gap: 12px;
                align-items: center
            }

            .add-btn {
                flex: 1;
                background: var(--brand);
                color: #fff;
                padding: 14px 16px;
                border-radius: 13px;
                font-weight: 700;
                display: flex;
                justify-content: space-between
            }

                .add-btn:hover {
                    background: var(--brand-dark)
                }

            .rc {
                width: min(380px,94%);
                background: #fff;
                border-radius: 20px;
                padding: 26px 24px 20px;
                max-height: 92vh;
                overflow-y: auto;
                text-align: center
            }

                .rc .ok {
                    width: 60px;
                    height: 60px;
                    border-radius: 50%;
                    background: var(--brand);
                    color: #fff;
                    display: grid;
                    place-items: center;
                    margin: 0 auto 10px;
                    font-size: 28px
                }

                .rc .num {
                    font-size: 64px;
                    font-weight: 800;
                    color: var(--brand);
                    line-height: 1;
                    letter-spacing: .03em;
                    margin: 6px 0
                }

                .rc .cut {
                    border-top: 2px dashed #e8e0d8;
                    margin: 14px 0
                }

                .rc .r {
                    display: flex;
                    justify-content: space-between;
                    gap: 10px;
                    text-align: left;
                    font-size: 13px;
                    padding: 5px 0
                }

                    .rc .r small {
                        color: var(--muted);
                        display: block
                    }

                    .rc .r.disc {
                        color: var(--ok);
                        font-weight: 600
                    }

                .rc .link {
                    background: var(--brand-softer);
                    border-radius: 10px;
                    padding: 8px;
                    font-size: 12px;
                    font-weight: 700;
                    color: var(--brand-dark);
                    margin: 8px 0
                }

                .rc .btns {
                    display: flex;
                    gap: 8px;
                    margin-top: 16px
                }

                    .rc .btns button {
                        flex: 1;
                        padding: 13px;
                        border-radius: 12px;
                        font-weight: 700;
                        font-size: 14px
                    }

            .b-print {
                border: 1.5px solid var(--line)
            }

            .b-new {
                background: var(--brand);
                color: #fff
            }

            #toast {
                position: fixed;
                left: 50%;
                bottom: 24px;
                transform: translateX(-50%);
                background: var(--ink);
                color: #fff;
                padding: 10px 18px;
                border-radius: 12px;
                font-size: 13px;
                font-weight: 600;
                opacity: 0;
                transition: .25s;
                pointer-events: none;
                z-index: 80
            }

                #toast.show {
                    opacity: 1
                }

            @@media (max-width:900px) {
                .app {
                    grid-template-columns: 1fr 340px
                }
            }

            @@media print {
                body {
                    overflow: visible;
                    background: #fff
                }

                .app > *, #toast, #modal {
                    display: none !important
                }

                #receipt {
                    position: static;
                    background: none;
                    backdrop-filter: none;
                    opacity: 1;
                    display: block !important
                }

                .rc {
                    box-shadow: none;
                    max-height: none;
                    width: 100%
                }

                .btns {
                    display: none !important
                }
            }
    </style>
</head>
<body>
    <div class="app">
        <div class="topbar">
            <div class="left">
                <!-- TODO: change href to your real cashier dashboard page -->
                <a class="tb-btn" id="backBtn" href="/Cashier/Dashboard"
                   onclick="if (cart.length && !confirm('You have items on the ticket. Leave without charging?')) return false;">
                    <i class="fa-solid fa-arrow-left"></i> Dashboard
                </a>
                <div class="logo"><i class="fa-solid fa-cash-register"></i></div>
                <div class="name">VERSO CAFE · POS</div>
                <span class="pill">Cashier</span>
            </div>
            <div style="display:flex;align-items:center;gap:14px;color:var(--muted);font-size:14px">
                <span id="clock"></span>
                <button class="tb-btn" onclick="newSale(true)"><i class="fa-solid fa-rotate-left"></i> Clear sale</button>
            </div>
        </div>

        <!-- CATALOG -->
        <main class="catalog">
            <div class="cat-bar" id="cats"></div>
            <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input id="search" placeholder="Search the menu..." /></div>
            <div class="grid" id="grid"></div>
        </main>

        <!-- TICKET -->
        <aside class="ticket">
            <div class="t-sec">
                <div class="t-label">Customer</div>
                <input class="field" id="custName" placeholder="Walk-in" maxlength="60" />
                <div class="t-label" style="margin-top:14px">Add to an existing order</div>
                <div class="addon-row">
                    <input class="field" id="addonNum" placeholder="Order no. e.g. ORD-00012" />
                    <button class="find" onclick="lookupOrder($('#addonNum').value)">Find</button>
                </div>
                <div class="recent" id="recent"></div>
                <div id="linked"></div>
                <div class="err" id="linkErr"></div>
            </div>

            <div class="lines" id="lines"></div>

            <div class="pay">
                <!-- DISCOUNT -->
                <div class="disc-box">
                    <div class="t-label">Discount</div>
                    <div class="disc-seg" id="discSeg">
                        <button data-d="" class="on" onclick="setDiscount(null)">None</button>
                        <button data-d="PWD" onclick="setDiscount('PWD')"><i class="fa-solid fa-wheelchair"></i> PWD</button>
                        <button data-d="Senior" onclick="setDiscount('Senior')"><i class="fa-solid fa-person-cane"></i> Senior</button>
                    </div>
                    <div class="disc-fields" id="discFields">
                        <input class="field" id="dIdNum" placeholder="ID number (numbers only)" maxlength="40" autocomplete="off" inputmode="numeric" pattern="[0-9]*" />
                        <input class="field" id="dIdName" placeholder="Name on ID (letters only)" maxlength="80" autocomplete="off" />
                        <div class="disc-note">Check the customer's valid ID before applying.</div>
                    </div>
                </div>

                <div class="srow" id="subRow" style="display:none"><span>Subtotal</span><span>₱<span id="sub">0.00</span></span></div>
                <div class="srow disc" id="discRow" style="display:none"><span id="discLabel">Discount</span><span>−₱<span id="discAmt">0.00</span></span></div>
                <div class="srow total"><span>Total</span><span>₱<span id="tot">0.00</span></span></div>
                <div class="t-label" style="margin:10px 0 6px">Cash received</div>
                <input class="field" id="tendered" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00" />
                <div class="quick" id="quick"></div>
                <div class="srow change" id="changeRow"><span>Change</span><b>₱<span id="chg">0.00</span></b></div>
                <div class="err" id="payErr"></div>
                <button class="charge" id="charge" onclick="charge()" disabled><i class="fa-solid fa-lock"></i> <span id="chargeTxt">Charge</span></button>
                <button class="clear" onclick="newSale(true)">Clear sale</button>
            </div>
        </aside>

        <!-- ITEM MODAL -->
        <div class="ov" id="modal">
            <div class="modal">
                <div class="m-head" id="mHead">
                    <button class="m-close" onclick="closeModal()"><i class="fa-solid fa-xmark"></i></button>
                    <i id="mIcon" class="fa-solid fa-mug-hot"></i>
                </div>
                <div class="m-body">
                    <h3 id="mName"></h3><p class="m-desc" id="mDesc"></p>
                    <div id="mCust"></div><div id="mAddons"></div>
                </div>
                <div class="m-foot">
                    <div class="step"><button onclick="changeQty(-1)"><i class="fa-solid fa-minus"></i></button><span id="qty">1</span><button onclick="changeQty(1)"><i class="fa-solid fa-plus"></i></button></div>
                    <button class="add-btn" onclick="addFromModal()"><span>Add to ticket</span><span>₱<span id="mPrice">0.00</span></span></button>
                </div>
            </div>
        </div>

        <!-- RECEIPT -->
        <div class="ov" id="receipt">
            <div class="rc">
                <div class="ok"><i class="fa-solid fa-check"></i></div>
                <div style="font-weight:800;font-size:20px">Payment received</div>
                <div style="color:var(--muted);font-size:12px">Verso Cafe · <span id="rcTime"></span></div>
                <div class="cut"></div>
                <div style="font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)">Order number</div>
                <div class="num" id="rcNum">—</div>
                <div class="link" id="rcLink" style="display:none"></div>
                <div style="font-size:13px;color:var(--ink-2)" id="rcCust"></div>
                <div class="cut"></div>
                <div id="rcItems"></div>
                <div class="cut"></div>
                <div class="r" id="rcSubRow" style="display:none"><span>Subtotal</span><span>₱<span id="rcSub"></span></span></div>
                <div class="r disc" id="rcDiscRow" style="display:none"><span id="rcDiscLabel">Discount</span><span>−₱<span id="rcDisc"></span></span></div>
                <div class="r" id="rcIdRow" style="display:none"><small id="rcIdText" style="color:var(--muted)"></small></div>
                <div class="r"><b>Total</b><b>₱<span id="rcTotal"></span></b></div>
                <div class="r"><span>Cash</span><span>₱<span id="rcCash"></span></span></div>
                <div class="r"><span>Change</span><b style="color:var(--ok)">₱<span id="rcChange"></span></b></div>
                <div class="btns">
                    <button class="b-print" onclick="window.print()"><i class="fa-solid fa-print"></i> Print</button>
                    <button class="b-new" onclick="newSale(false)"><i class="fa-solid fa-plus"></i> New sale</button>
                </div>
            </div>
        </div>
    </div>
    <div id="toast"></div>

    <script>
            const categories = @Html.Raw(Model.CategoriesJson ?? "[]");
            const items      = @Html.Raw(Model.ItemsJson ?? "[]");
            const IMAGE_URL  = @Html.Raw(imageUrlJson);

            // ── Discount settings: KEEP THESE THE SAME as PosOrdersController ──
            const APPLY_VAT_EXEMPTION = false;
            const VAT_RATE = 0.12;
            const DISCOUNT_RATE = 0.20;

            let currentCat = categories.length ? categories[0].id : null;
            let cart = [], linked = null, discType = null;   // discType: null | 'PWD' | 'Senior'
            let editing = null, selections = {}, addons = {}, mQty = 1;

            const $  = (s, p = document) => p.querySelector(s);
            const $$ = (s, p = document) => [...p.querySelectorAll(s)];
            const money = n => Number(n || 0).toFixed(2);
            const round2 = n => Math.round((n + Number.EPSILON) * 100) / 100;
            const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
            const imgUrl = it => it && it.hasImage ? IMAGE_URL + '&id=' + encodeURIComponent(it.id) : null;

            // Money math: subtotal -> discount -> total (what the customer pays)
            const subtotal = () => cart.reduce((a, c) => a + c.qty * c.unit, 0);
            function discountAmt() {
                if (!discType) return 0;
                const s = subtotal();
                const basis = APPLY_VAT_EXEMPTION ? s / (1 + VAT_RATE) : s;
                return round2(s - round2(basis * (1 - DISCOUNT_RATE)));
            }
            const cartTotal = () => round2(subtotal() - discountAmt());
            const discountIdOk = () => !discType || ($('#dIdNum').value.trim() && $('#dIdName').value.trim());

            function toast(msg) {
                const t = $('#toast'); t.textContent = msg; t.classList.add('show');
                clearTimeout(toast.t); toast.t = setTimeout(() => t.classList.remove('show'), 2200);
            }

            // ── Clock ──
            (function tick() {
                $('#clock').innerHTML = '<i class="fa-regular fa-clock"></i> ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                setTimeout(tick, 30000);
            })();

            // ── Catalog ──
            function renderCats() {
                $('#cats').innerHTML = categories.map(c =>
                    `<button class="cat ${c.id === currentCat ? 'active' : ''}" data-id="${c.id}">${esc(c.name)}</button>`).join('');
                $$('#cats .cat').forEach(b => b.onclick = () => { currentCat = b.dataset.id; $('#search').value = ''; renderCats(); renderGrid(); });
            }

            function renderGrid(filter = '') {
                const q = filter.trim().toLowerCase();
                const list = items.filter(i => q ? (i.name + (i.desc || '')).toLowerCase().includes(q) : i.cat === currentCat);
                $('#grid').innerHTML = list.length ? list.map(i => `
                    <button class="card${i.isAvailable ? '' : ' off'}" data-id="${i.id}" ${i.isAvailable ? '' : 'disabled'}>
                        <div class="thumb">${i.hasImage ? `<img src="${imgUrl(i)}" alt="" loading="lazy" decoding="async" />` : '<i class="fa-solid fa-mug-hot"></i>'}</div>
                        <h4>${esc(i.name)}</h4>
                        <div class="price">${i.isAvailable ? '₱' + money(i.price) : 'Unavailable'}</div>
                    </button>`).join('') : '<div class="empty">No items found.</div>';
                $$('#grid .card:not(.off)').forEach(c => c.onclick = () => tapItem(c.dataset.id));
            }

            let st = null;
            $('#search').addEventListener('input', e => { clearTimeout(st); st = setTimeout(() => renderGrid(e.target.value), 200); });

            // Plain items go straight onto the ticket (fast for the cashier); items with options open the modal.
            function tapItem(id) {
                const it = items.find(i => i.id == id);
                if (!it || !it.isAvailable) return;
                const hasOpts = (it.customizations || []).length || (it.addons || []).length;
                if (!hasOpts) { pushLine(it, [], it.price, 1, {}, {}); return; }
                openModal(it);
            }

            // ── Modal ──
            function openModal(it) {
                editing = it; selections = {}; addons = {}; mQty = 1;
                const head = $('#mHead'); head.querySelectorAll('img').forEach(e => e.remove());
                $('#mIcon').style.display = '';
                if (it.hasImage) { const im = document.createElement('img'); im.src = imgUrl(it); head.appendChild(im); $('#mIcon').style.display = 'none'; }
                $('#mName').textContent = it.name; $('#mDesc').textContent = it.desc || ''; $('#qty').textContent = 1;

                const cust = $('#mCust'); cust.innerHTML = '';
                (it.customizations || []).forEach(c => {
                    selections[c.id] = c.options.filter(o => o.isDefault).map(o => o.id);
                    if (c.type === 'Radio' && !selections[c.id].length && c.options.length) selections[c.id] = [c.options[0].id];
                    const g = document.createElement('div'); g.className = 'grp';
                    g.innerHTML = `<div class="t-label">${esc(c.name)}${c.required ? ' <span style="color:var(--brand)">*</span>' : ''}</div>
                        <div class="${c.type === 'Radio' ? 'seg' : 'chips'}">${c.options.map(o => `
                            <button class="${c.type === 'Radio' ? '' : 'chip'} ${selections[c.id].includes(o.id) ? 'on' : ''}" data-c="${c.id}" data-o="${o.id}" data-t="${c.type}">
                                ${esc(o.label)}${o.priceModifier > 0 ? ` (+₱${money(o.priceModifier)})` : ''}</button>`).join('')}</div>`;
                    cust.appendChild(g);
                });

                const ad = $('#mAddons'); ad.innerHTML = '';
                if ((it.addons || []).length) {
                    const g = document.createElement('div'); g.className = 'grp';
                    g.innerHTML = `<div class="t-label">Add-ons</div><div class="chips">${it.addons.map(a => `
                        <button class="chip" data-a="${a.id}" data-p="${a.price}">${esc(a.name)}${a.price > 0 ? ` (+₱${money(a.price)})` : ''}</button>`).join('')}</div>`;
                    ad.appendChild(g);
                }

                $$('#mCust [data-c]').forEach(b => b.onclick = () => {
                    const cid = b.dataset.c, oid = b.dataset.o;
                    if (b.dataset.t === 'Radio') {
                        selections[cid] = [oid];
                        $$(`[data-c="${cid}"]`).forEach(x => x.classList.toggle('on', x.dataset.o === oid));
                    } else {
                        const s = selections[cid] || [];
                        selections[cid] = s.includes(oid) ? s.filter(x => x !== oid) : [...s, oid];
                        b.classList.toggle('on');
                    }
                    updModal();
                });
                $$('#mAddons [data-a]').forEach(b => b.onclick = () => {
                    const a = b.dataset.a;
                    if (addons[a] !== undefined) { delete addons[a]; b.classList.remove('on'); }
                    else { addons[a] = parseFloat(b.dataset.p); b.classList.add('on'); }
                    updModal();
                });
                updModal();
                $('#modal').classList.add('show');
            }
            function closeModal() { $('#modal').classList.remove('show'); }
            function modalUnit() {
                let t = editing.price;
                Object.entries(selections).forEach(([cid, ids]) => {
                    const c = editing.customizations.find(x => x.id == cid);
                    ids.forEach(oid => { const o = c && c.options.find(x => x.id == oid); if (o) t += o.priceModifier; });
                });
                Object.values(addons).forEach(p => t += p);
                return t;
            }
            function updModal() { $('#mPrice').textContent = money(modalUnit() * mQty); }
            function changeQty(d) { mQty = Math.max(1, Math.min(20, mQty + d)); $('#qty').textContent = mQty; updModal(); }

            function addFromModal() {
                const mods = [];
                Object.entries(selections).forEach(([cid, ids]) => {
                    const c = editing.customizations.find(x => x.id == cid);
                    ids.forEach(oid => { const o = c && c.options.find(x => x.id == oid); if (o) mods.push(o.label); });
                });
                Object.keys(addons).forEach(aid => { const a = editing.addons.find(x => x.id == aid); if (a) mods.push(a.name); });
                pushLine(editing, mods, modalUnit(), mQty);
                closeModal();
            }

            // ── Ticket ──
            function pushLine(it, mods, unit, qty) {
                // Same item with the same options just bumps the quantity
                const key = it.id + '|' + mods.join(',');
                const ex = cart.find(l => l.key === key);
                if (ex) ex.qty += qty;
                else cart.push({ id: Date.now() + Math.random(), key, itemId: it.id, name: it.name, unit, qty, mods, prep: it.prepTime || 5 });
                renderCart();
            }
            function bump(id, d) {
                const l = cart.find(x => x.id === id); if (!l) return;
                l.qty += d; if (l.qty < 1) cart = cart.filter(x => x.id !== id);
                renderCart();
            }
            function removeLine(id) { cart = cart.filter(x => x.id !== id); renderCart(); }

            function renderCart() {
                $('#lines').innerHTML = cart.length ? cart.map(l => `
                    <div class="line">
                        <div class="top"><span>${esc(l.name)}</span><span>₱${money(l.qty * l.unit)}</span></div>
                        <div class="mods">${esc(l.mods.join(' · ')) || 'No customizations'}</div>
                        <div class="ctl">
                            <div class="step"><button onclick="bump(${l.id},-1)"><i class="fa-solid fa-minus"></i></button><span>${l.qty}</span><button onclick="bump(${l.id},1)"><i class="fa-solid fa-plus"></i></button></div>
                            <button class="rm" onclick="removeLine(${l.id})"><i class="fa-regular fa-trash-can"></i> Remove</button>
                        </div>
                    </div>`).join('')
                    : '<div class="no-lines"><i class="fa-solid fa-basket-shopping"></i>Tap an item to start the ticket</div>';
                renderTotals();
            }

            // Refresh subtotal / discount / total, quick-cash buttons and the charge button
            function renderTotals() {
                const sub = subtotal(), disc = discountAmt();
                $('#sub').textContent = money(sub);
                $('#discAmt').textContent = money(disc);
                $('#discLabel').textContent = discType ? (discType === 'PWD' ? 'PWD discount' : 'Senior Citizen discount') + (APPLY_VAT_EXEMPTION ? ' (VAT-exempt + 20%)' : ' (20%)') : 'Discount';
                $('#subRow').style.display = discType ? '' : 'none';
                $('#discRow').style.display = discType ? '' : 'none';
                $('#tot').textContent = money(cartTotal());
                renderQuick(); updatePay();
            }

            // ── Discount ──
            function setDiscount(type) {
                discType = type;
                $$('#discSeg button').forEach(b => b.classList.toggle('on', (b.dataset.d || null) === type));
                $('#discFields').classList.toggle('show', !!type);
                if (!type) { $('#dIdNum').value = ''; $('#dIdName').value = ''; }
                else if (!$('#dIdName').value.trim()) $('#dIdName').value = cleanName($('#custName').value.trim());
                renderTotals();
                if (type) $('#dIdNum').focus();
            }
            // ID number: digits only. Name: letters, spaces, dots, hyphens and apostrophes only.
            // Typing and pasting are both cleaned, so bad characters can never stay in the box.
            const cleanId   = v => v.replace(/\D/g, '');
            const cleanName = v => v.replace(/[^\p{L}\s.'\-]/gu, '');
            $('#dIdNum').addEventListener('input', e => { e.target.value = cleanId(e.target.value); updatePay(); });
            $('#dIdName').addEventListener('input', e => { e.target.value = cleanName(e.target.value); updatePay(); });

            // ── Add-on to existing order ──
            async function loadRecent() {
                try {
                    const r = await fetch('/api/pos/orders/recent'); if (!r.ok) return;
                    const list = await r.json();
                    $('#recent').innerHTML = list.map(o =>
                        `<button class="rchip" onclick="lookupOrder('${esc(o.orderNumber)}')">${esc(o.orderNumber)} · ${esc(o.customerName)}</button>`).join('');
                } catch { }
            }
            async function lookupOrder(num) {
                num = (num || '').trim(); $('#linkErr').textContent = '';
                if (!num) return;
                try {
                    const r = await fetch('/api/pos/orders/' + encodeURIComponent(num));
                    if (!r.ok) { $('#linkErr').textContent = 'Order not found. Check the number and try again.'; return; }
                    linked = await r.json();
                    $('#custName').value = linked.customerName; $('#custName').disabled = true;
                    $('#addonNum').value = '';
                    renderLinked();
                } catch { $('#linkErr').textContent = 'Could not reach the server.'; }
            }
            function renderLinked() {
                $('#linked').innerHTML = linked ? `
                    <div class="linked">
                        <div><b>Adding to ${esc(linked.orderNumber)}</b>
                            <small>${esc(linked.customerName)} · ${esc(linked.status)} · ₱${money(linked.total)} so far</small>
                            <small>${linked.items.map(i => i.quantity + '× ' + esc(i.name)).join(', ')}</small></div>
                        <button onclick="unlink()" aria-label="Remove link"><i class="fa-solid fa-xmark"></i></button>
                    </div>` : '';
                $('#chargeTxt').textContent = linked ? 'Charge add-on' : 'Charge';
            }
            function unlink() { linked = null; $('#custName').disabled = false; $('#custName').value = ''; renderLinked(); }

            // ── Payment ──
            function renderQuick() {
                const t = cartTotal(), opts = new Set();
                if (t > 0) { opts.add(t); [50, 100, 200, 500, 1000].forEach(d => { const v = Math.ceil(t / d) * d; if (v >= t) opts.add(v); }); }
                $('#quick').innerHTML = [...opts].slice(0, 5).map((v, i) =>
                    `<button onclick="setCash(${v})">${i === 0 ? 'Exact' : '₱' + v}</button>`).join('');
            }
            function setCash(v) { $('#tendered').value = v; updatePay(); }
            function updatePay() {
                const t = cartTotal(), c = parseFloat($('#tendered').value) || 0, diff = round2(c - t);
                $('#chg').textContent = money(Math.max(0, diff));
                $('#changeRow').classList.toggle('short', c > 0 && diff < 0);
                const short = c > 0 && diff < 0;
                const needId = !discountIdOk();
                $('#payErr').textContent = short ? `Short by ₱${money(-diff)}` : (needId && cart.length ? 'Enter the ID number and name for the discount' : '');
                $('#charge').disabled = !cart.length || diff < 0 || needId;
            }
            $('#tendered').addEventListener('input', updatePay);

            async function charge() {
                const btn = $('#charge'); btn.disabled = true;
                const tendered = parseFloat($('#tendered').value) || 0;
                const qtySum = cart.reduce((a, c) => a + c.qty, 0);
                const avgPrep = Math.ceil(cart.reduce((a, c) => a + c.prep * c.qty, 0) / qtySum);
                const payload = {
                    customerName: $('#custName').value.trim(),
                    addOnToOrderNumber: linked ? linked.orderNumber : null,
                    amountTendered: tendered,
                    estimatedMinutes: avgPrep,
                    discountType: discType,
                    discountIdNumber: discType ? $('#dIdNum').value.trim() : null,
                    discountIdName: discType ? $('#dIdName').value.trim() : null,
                    items: cart.map(l => ({ menuItemId: String(l.itemId), name: l.name, quantity: l.qty, unitPrice: l.unit, customization: l.mods.join(', '), specialInstructions: '' }))
                };
                try {
                    const res = await fetch('/api/pos/orders', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                    if (!res.ok) { let m = 'HTTP ' + res.status; try { m = (await res.json()).error || m; } catch { } throw new Error(m); }
                    showReceipt(await res.json(), payload);
                } catch (e) {
                    updatePay();   // refresh the button first (it also clears the message), then show the error
                    $('#payErr').textContent = 'Could not complete the sale: ' + e.message;
                    toast(e.message);
                }
            }

            function showReceipt(d, p) {
                $('#rcNum').textContent = d.orderNumber;
                $('#rcTime').textContent = new Date().toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
                $('#rcCust').textContent = linked ? linked.customerName : (p.customerName || 'Walk-in');
                const lk = $('#rcLink'); lk.style.display = d.addOnTo ? '' : 'none'; lk.textContent = d.addOnTo ? 'Add-on to ' + d.addOnTo : '';
                $('#rcItems').innerHTML = cart.map(l => `<div class="r"><div>${l.qty}× ${esc(l.name)}<small>${esc(l.mods.join(' · '))}</small></div><span>₱${money(l.qty * l.unit)}</span></div>`).join('');

                // Use the server's figures so the receipt always matches what was saved
                const hasDisc = !!d.discountType && d.discountAmount > 0;
                $('#rcSubRow').style.display = hasDisc ? '' : 'none';
                $('#rcDiscRow').style.display = hasDisc ? '' : 'none';
                $('#rcIdRow').style.display = hasDisc ? '' : 'none';
                if (hasDisc) {
                    $('#rcSub').textContent = money(d.subtotal);
                    $('#rcDisc').textContent = money(d.discountAmount);
                    $('#rcDiscLabel').textContent = (d.discountType === 'PWD' ? 'PWD' : 'Senior Citizen') + ' discount';
                    $('#rcIdText').textContent = 'ID: ' + (p.discountIdNumber || '') + ' · ' + (p.discountIdName || '');
                }
                $('#rcTotal').textContent = money(d.total); $('#rcCash').textContent = money(d.tendered); $('#rcChange').textContent = money(d.change);
                $('#receipt').classList.add('show');
            }

            function newSale(confirmFirst) {
                if (confirmFirst && cart.length && !confirm('Clear the current ticket?')) return;
                cart = []; linked = null;
                $('#custName').value = ''; $('#custName').disabled = false; $('#tendered').value = ''; $('#linkErr').textContent = '';
                $('#receipt').classList.remove('show');
                setDiscount(null);
                renderLinked(); renderCart(); loadRecent();
            }

            $('#addonNum').addEventListener('keydown', e => { if (e.key === 'Enter') lookupOrder(e.target.value); });

            // ── Init ──
            renderCats(); renderGrid(); renderLinked(); renderCart(); loadRecent();
    </script>
</body>
</html>
