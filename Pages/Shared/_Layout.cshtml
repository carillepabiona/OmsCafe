@{
    var path = Context.Request.Path.ToString();
    bool isAdmin = path.StartsWith("/Admin");
    bool isCashier = path.StartsWith("/Cashier");
    bool isLogin = path == "/" || path.Contains("Login");

    // Username of the logged-in user
    var username = User.Identity?.Name
                   ?? Context.Session.GetString("Username")
                   ?? "User";

    var initials = username.Length >= 2
        ? username.Substring(0, 2).ToUpper()
        : username.ToUpper();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover lets the layout use the full phone screen; site.css handles the notch -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - WebPOSCafe</title>

    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=DM+Serif+Display&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OmsCafe.styles.css" asp-append-version="true" />

    @* Applies the saved light/dark theme before first paint *@
    <script src="~/js/theme.js"></script>
</head>

<body>

    @if (!isLogin)
    {
        <div class="app-layout">

            <!-- SIDEBAR (becomes a slide-in drawer on tablets and phones) -->
            <aside class="sidebar" id="sidebar" aria-label="Main navigation">

                <div class="sidebar-logo">
                    <div class="sidebar-wordmark">
                        <span class="sidebar-icon"><i class="fa-solid fa-mug-saucer"></i></span>
                        <span class="sidebar-name">Verso Cafe</span>
                    </div>
                    <div class="sidebar-sub">
                        @if (isAdmin)
                        {
                            <span>Admin Panel</span>
                        }
                        @if (isCashier)
                        {
                            <span>Cashier Panel</span>
                        }
                    </div>

                    <button type="button" class="sidebar-close" id="sidebar-close" aria-label="Close menu">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    </button>
                </div>

                <nav class="nav-menu">

                    @if (isAdmin)
                    {
                        <div class="nav-label">Management</div>
                        <a asp-page="/Admin/AccountManagement" class="nav-item @(path.Contains("AccountManagement") ? "active" : "")">
                            <i class="ti ti-users" aria-hidden="true"></i>
                            Account Management
                        </a>
                        <a asp-page="/Admin/MenuManagement" class="nav-item @(path.Contains("MenuManagement") ? "active" : "")">
                            <i class="ti ti-clipboard-list" aria-hidden="true"></i>
                            Menu Management
                        </a>
                        <a asp-page="/Admin/Reports" class="nav-item @(path.Contains("Reports") ? "active" : "")">
                            <i class="ti ti-chart-bar" aria-hidden="true"></i>
                            Reports
                        </a>
                        <a asp-page="/Admin/CashReconciliation"
                           class="nav-item @(path.Contains("CashReconciliation", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="ti ti-cash-banknote" aria-hidden="true"></i>
                            Cash Reconciliation
                        </a>
                        <a asp-page="/Admin/GenerateQRCodes"
                           class="nav-item @(path.Contains("GenerateQRCodes") ? "active" : "")">
                            <i class="ti ti-qrcode" aria-hidden="true"></i>
                            Generate QR Codes
                        </a>
                        <a asp-page="/Admin/Settings" class="nav-item @(path.Contains("Settings") ? "active" : "")">
                            <i class="ti ti-settings" aria-hidden="true"></i>
                            Settings
                        </a>
                    }

                    @if (isCashier)
                    {
                        <div class="nav-label">Cashier</div>
                        <a asp-page="/Cashier/Dashboard" class="nav-item @(path.Contains("Dashboard") ? "active" : "")">
                            <i class="ti ti-home" aria-hidden="true"></i>
                            Dashboard
                        </a>
                        <a asp-page="/Cashier/Pos" class="nav-item @(path.Contains("POS") ? "active" : "")">
                            <i class="ti ti-cash" aria-hidden="true"></i>
                            POS
                        </a>
                        <a asp-page="/Cashier/Orders" class="nav-item @(path.Contains("Orders") ? "active" : "")">
                            <i class="ti ti-receipt" aria-hidden="true"></i>
                            Orders
                        </a>
                        <a asp-page="/Cashier/Payments" class="nav-item @(path.Contains("Payments") ? "active" : "")">
                            <i class="ti ti-credit-card" aria-hidden="true"></i>
                            Payments
                        </a>
                        <a asp-page="/Cashier/Tables" class="nav-item @(path.Contains("Tables") ? "active" : "")">
                            <i class="ti ti-armchair" aria-hidden="true"></i>
                            Tables
                        </a>
                        <a asp-page="/Cashier/TransactionHistory" class="nav-item @(path.Contains("TransactionHistory") ? "active" : "")">
                            <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
                            Transaction History
                        </a>
                        <a asp-page="/Cashier/CloseShift" class="nav-item @(path.Contains("CloseShift") ? "active" : "")">
                            <i class="ti ti-cash" aria-hidden="true"></i>
                            Close Shift
                        </a>
                    }

                </nav>

                <div class="sidebar-footer">
                    <div class="user-chip">
                        <div class="user-avatar">@initials</div>
                        <div class="user-info">
                            <p class="user-name">Welcome, @username</p>
                            <span class="user-role">
                                @if (isAdmin)
                                {
                                    <span>Administrator</span>
                                }
                                @if (isCashier)
                                {
                                    <span>Cashier</span>
                                }
                            </span>
                        </div>
                    </div>

                    @* Cashiers must close their shift before signing out (see _LogoutGuard) *@
                    <a href="#" class="logout-link" onclick="signOutNow(); return false;">
                        <i class="ti ti-logout" aria-hidden="true"></i>
                        Sign out
                    </a>
                </div>

            </aside>

            <!-- Dark overlay behind the drawer (tap it to close) -->
            <div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

            <!-- MAIN CONTENT -->
            <div class="main-content">

                <header class="topbar">
                    <div class="topbar-left">
                        <button type="button" class="menu-toggle" id="menu-toggle"
                                aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                        </button>

                        <div class="topbar-heading">
                            <h1 class="topbar-title">@ViewData["Title"]</h1>
                            <p class="topbar-sub">@ViewData["Subtitle"]</p>
                        </div>
                    </div>

                    <div class="topbar-right">
                        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode">
                            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                        </button>

                        @* Rendered ONCE only. Razor throws an error if a section is rendered twice. *@
                        @await RenderSectionAsync("TopbarActions", required: false)
                    </div>
                </header>

                <div class="content">
                    @RenderBody()
                </div>

            </div>

        </div>

        @* Logout popup + signOutNow() function. Only needed on pages that have the sidebar. *@
        <partial name="_LogoutGuard" />
    }
    else
    {
        <main class="login-main">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (!isLogin)
    {
        <script>
            // Sidebar drawer (tablet / phone)
            (function () {
                var sidebar  = document.getElementById("sidebar");
                var backdrop = document.getElementById("sidebar-backdrop");
                var toggle   = document.getElementById("menu-toggle");
                var closeBtn = document.getElementById("sidebar-close");
                if (!sidebar || !backdrop || !toggle) return;

                var mq = window.matchMedia("(max-width: 900px)");

                function isOpen() { return sidebar.classList.contains("open"); }

                function setOpen(open) {
                    sidebar.classList.toggle("open", open);
                    backdrop.classList.toggle("show", open);
                    toggle.setAttribute("aria-expanded", String(open));
                    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
                    if (open && closeBtn) closeBtn.focus();
                }

                toggle.addEventListener("click", function () {
                    var next = !isOpen();
                    setOpen(next);
                    if (!next) toggle.focus();
                });

                if (closeBtn) closeBtn.addEventListener("click", function () { setOpen(false); toggle.focus(); });
                backdrop.addEventListener("click", function () { setOpen(false); });

                // Close after choosing a page (or tapping Sign out)
                sidebar.addEventListener("click", function (e) {
                    if (mq.matches && e.target.closest("a")) setOpen(false);
                });

                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && isOpen()) { setOpen(false); toggle.focus(); }
                });

                // Rotating a tablet or resizing the window back to desktop resets the drawer
                var onChange = function (e) { if (!e.matches) setOpen(false); };
                if (mq.addEventListener) mq.addEventListener("change", onChange);
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
